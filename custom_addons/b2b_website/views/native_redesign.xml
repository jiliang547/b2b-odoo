<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_layout_figma" inherit_id="portal.portal_layout" name="Partner Hub Portal Layout">
        <xpath expr="//t[@t-set='is_portal']" position="before"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-set="no_breadcrumbs" t-value="True"/></xpath>
        <xpath expr="//div[@id='wrap']" position="before"><t t-call="b2b_website.partner_topbar"/></xpath>
        <xpath expr="//div[@id='wrap']" position="attributes"><attribute name="class" add="lt-portal-wrap" separator=" "/></xpath>
        <xpath expr="//div[@id='wrap']/div[hasclass('container')]" position="attributes"><attribute name="class" add="lt-portal-shell is-sidebar-collapsed" separator=" "/></xpath>
        <xpath expr="//div[@id='wrap']/div[hasclass('container')]" position="inside"><t t-call="b2b_website.partner_portal_sidebar"/></xpath>
        <xpath expr="//div[@id='wrap']/div[hasclass('container')]/t[@t-else='']" position="replace"><t t-else=""><main class="lt-portal-main"><t t-out="0"/></main></t></xpath>
    </template>

    <template id="portal_home_figma" inherit_id="portal.portal_my_home" name="Partner Hub Account Dashboard" priority="90">
        <xpath expr="//div[hasclass('o_portal_my_home')]" position="replace">
            <t t-set="company" t-value="request.env.user.partner_id.commercial_partner_id"/>
            <div class="o_portal_my_home lt-portal-dashboard">
                <nav class="lt-portal-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Overview</span></nav>
                <header class="lt-portal-heading">
                    <h1>Welcome back, <t t-out="request.env.user.name"/></h1>
                    <p class="lt-portal-heading__placeholder" aria-hidden="true">Account overview</p>
                </header>
                <section t-if="not b2b_has_linked_company" t-att-class="'lt-company-onboarding-card ' + ('is-pending' if b2b_open_company_request or b2b_registration_application.state == 'pending' else 'is-action')">
                    <span><i t-att-class="'fa ' + ('fa-clock-o' if b2b_open_company_request or b2b_registration_application.state == 'pending' else 'fa-building-o')"/></span>
                    <div>
                        <strong t-if="b2b_registration_application.state == 'pending'">Partner registration under review</strong>
                        <strong t-elif="b2b_registration_application.state == 'rejected'">Partner registration needs attention</strong>
                        <strong t-else="" t-out="'Company request under review' if b2b_open_company_request else 'Connect your company account'"/>
                        <p t-if="b2b_registration_application.state == 'pending'">Your email is verified. Our team is reviewing your company information before Partner Hub access is activated.</p>
                        <p t-elif="b2b_registration_application.state == 'rejected'">Your application was not approved. <t t-if="b2b_registration_application.rejection_reason">Reason: <t t-out="b2b_registration_application.rejection_reason"/></t> Contact our team if the information needs to be corrected.</p>
                        <p t-else="" t-out="'Our team is reviewing your company information. Your personal account remains unchanged until the review is complete.' if b2b_open_company_request else 'Submit your company information so our team can configure the correct pricing and product access.'"/>
                    </div>
                    <a t-if="b2b_open_company_request" class="lt-btn lt-btn--outline" t-att-href="'/my/inquiries/%s' % b2b_open_company_request.id">View Request</a>
                    <a t-elif="b2b_registration_application.state == 'rejected'" class="lt-btn lt-btn--outline" href="/contact">Contact Support</a>
                    <a t-elif="not b2b_registration_application" class="lt-btn lt-btn--blue" href="/my/company/change">Request Company Setup</a>
                </section>
                <div t-if="b2b_show_company_prompt" class="lt-company-onboarding-dialog" t-att-data-lt-company-onboarding="request.env.user.id" hidden="hidden">
                    <button type="button" class="lt-company-onboarding-dialog__backdrop" data-lt-company-onboarding-close="" aria-label="Close company setup reminder"/>
                    <section role="dialog" aria-modal="true" aria-labelledby="lt-company-onboarding-title">
                        <button type="button" class="lt-company-onboarding-dialog__close" data-lt-company-onboarding-close="" aria-label="Close"><i class="fa fa-times"/></button>
                        <span class="lt-company-onboarding-dialog__icon"><i class="fa fa-building-o"/></span>
                        <h2 id="lt-company-onboarding-title">Connect your company account</h2>
                        <p>Your account is not linked to a company yet. Send your company information for review so Lucky Tone can configure the correct pricing and product access.</p>
                        <div><a class="lt-btn lt-btn--blue" href="/my/company/change">Request Company Setup</a><button type="button" class="lt-btn lt-btn--outline" data-lt-company-onboarding-close="">Maybe Later</button></div>
                    </section>
                </div>
                <section class="lt-dashboard-metrics" aria-label="Account metrics">
                    <a href="/my/orders"><span class="lt-metric-icon lt-metric-icon--blue"><i class="fa fa-clipboard"/></span><strong t-out="order_count or 0"/><b>Orders</b><small>Orders and payment attempts</small></a>
                    <a href="/my/sample-requests"><span class="lt-metric-icon lt-metric-icon--green"><i class="fa fa-flask"/></span><strong t-out="sample_count or 0"/><b>Samples</b><small>Sample requests submitted</small></a>
                    <a href="/my/tickets"><span class="lt-metric-icon lt-metric-icon--orange"><i class="fa fa-comment-o"/></span><strong t-out="ticket_count or 0"/><b>Service</b><small>Support tickets</small></a>
                    <a href="/my/company"><span class="lt-metric-icon lt-metric-icon--green"><i class="fa fa-building-o"/></span><strong t-out="'Active' if b2b_has_linked_company and company.b2b_approved else ('Attention' if b2b_registration_application.state == 'rejected' else ('Review' if b2b_open_company_request or b2b_registration_application.state == 'pending' or b2b_has_linked_company else 'Setup'))"/><b>Account</b><small t-out="'Partner Hub Approved' if b2b_has_linked_company and company.b2b_approved else ('Registration needs attention' if b2b_registration_application.state == 'rejected' else ('Partner registration pending' if b2b_registration_application.state == 'pending' else ('Company request pending' if b2b_open_company_request else ('Approval pending' if b2b_has_linked_company else 'Company not linked'))))"/></a>
                </section>
                <section class="lt-quick-actions" aria-label="Quick actions">
                    <span>Quick Actions</span><div><a href="/products"><i class="fa fa-cube"/>Browse Products</a><a href="/products"><i class="fa fa-flask"/>Request a Sample</a><a href="/service"><i class="fa fa-ticket"/>New Service Request</a><a href="/contact"><i class="fa fa-commenting-o"/>Contact Support</a></div>
                </section>
                <div class="lt-dashboard-activity">
                    <section class="lt-portal-card lt-recent-orders"><header><h2>Recent Orders</h2><a href="/my/orders">View all</a></header><div t-if="recent_orders" class="lt-compact-list"><a t-foreach="recent_orders" t-as="order" t-att-href="order.get_portal_url()"><t t-set="current_tx" t-value="order.get_portal_last_transaction()"/><div><strong t-out="order.name"/><small t-field="order.date_order" t-options="{'widget':'date'}"/></div><span t-if="order.state == 'sale'" class="lt-status-badge lt-status-badge--sale">Confirmed</span><span t-elif="order.state == 'cancel'" class="lt-status-badge lt-status-badge--payment_cancelled">Order Cancelled</span><span t-elif="current_tx and current_tx.state in ('pending', 'authorized')" class="lt-status-badge lt-status-badge--payment_pending">Payment Pending</span><span t-elif="current_tx and current_tx.state == 'error'" class="lt-status-badge lt-status-badge--payment_failed">Payment Failed</span><span t-elif="current_tx and current_tx.state == 'cancel'" class="lt-status-badge lt-status-badge--payment_cancelled">Payment Cancelled</span><span t-else="" class="lt-status-badge lt-status-badge--awaiting_payment">Awaiting Payment</span><b t-field="order.amount_total"/></a></div><div t-else="" class="lt-empty lt-empty--compact">No order activity yet.</div></section>
                    <div class="lt-dashboard-activity__side">
                        <section class="lt-portal-card"><header><h2>Recent Samples</h2><a href="/my/sample-requests">View all</a></header><div t-if="recent_samples" class="lt-compact-list lt-compact-list--small"><a t-foreach="recent_samples" t-as="sample" t-att-href="'/my/sample-requests/%s' % sample.id"><div><strong t-out="sample.name"/><small t-out="', '.join(sample.line_ids.product_id.mapped('display_name'))"/></div><span t-att-class="'lt-status-badge lt-status-badge--%s' % sample.state" t-out="dict(sample._fields['state'].selection).get(sample.state)"/></a></div><div t-else="" class="lt-empty lt-empty--compact">No sample requests yet.</div></section>
                        <section class="lt-portal-card"><header><h2>Open Tickets</h2><a href="/my/tickets">View all</a></header><div t-if="recent_tickets" class="lt-compact-list lt-compact-list--small"><a t-foreach="recent_tickets" t-as="ticket" t-att-href="'/helpdesk/ticket/%s' % ticket.id"><div><strong t-out="ticket.ticket_ref"/><small t-out="ticket.name"/></div><span class="lt-status-badge lt-status-badge--under_review" t-out="ticket.stage_id.name"/></a></div><div t-else="" class="lt-empty lt-empty--compact">No service tickets yet.</div></section>
                        <section class="lt-portal-card"><header><h2>Recent Messages</h2><a href="/my/inquiries">View all (<t t-out="inquiry_count or 0"/>)</a></header><div t-if="recent_inquiries" class="lt-compact-list lt-compact-list--small"><a t-foreach="recent_inquiries" t-as="inquiry" t-att-href="'/my/inquiries/%s' % inquiry.id"><div><strong t-out="inquiry.name"/><small t-out="inquiry.subject"/></div><span t-att-class="'lt-status-badge lt-status-badge--%s' % inquiry.state" t-out="dict(inquiry._fields['state'].selection).get(inquiry.state)"/></a></div><div t-else="" class="lt-empty lt-empty--compact">No messages yet.</div></section>
                    </div>
                </div>
                <section class="lt-workspace"><h2>My Workspace</h2><div><article><i class="fa fa-shopping-bag"/><h3>Orders</h3><p>Track confirmed orders and complete interrupted payments.</p><a href="/my/orders">View Orders →</a></article><article><i class="fa fa-file-text-o"/><h3>Quotations</h3><p>Review and accept open quotations from Lucky Tone.</p><a href="/my/quotes">View Quotations →</a></article><article><i class="fa fa-comments-o"/><h3>Messages</h3><p>Read replies from sales and continue your conversations.</p><a href="/my/inquiries">View Messages →</a></article><article><i class="fa fa-flask"/><h3>Sample Requests</h3><p>Track your product sample requests and statuses.</p><a href="/my/sample-requests">View Samples →</a></article><article><i class="fa fa-life-ring"/><h3>After-Sales Service</h3><p>Submit and track technical support tickets.</p><a href="/my/tickets">View Tickets →</a></article><article><i class="fa fa-building-o"/><h3>Company Profile</h3><p>Your company's registered information and partner approval status.</p><a href="/my/company">View Profile →</a></article><article><i class="fa fa-users"/><h3>Company Users</h3><p>Contacts associated with your company account.</p><a href="/my/company/users">View Users →</a></article><article><i class="fa fa-user-o"/><h3>Personal Profile</h3><p>Update your personal contact details and address.</p><a href="/my/account">Edit Profile →</a></article></div></section>
                <div class="o_portal_docs d-none" aria-hidden="true"><div class="o_portal_doc_spinner spinner-border"/></div>
            </div>
        </xpath>
    </template>

    <template id="portal_orders_figma" inherit_id="sale.portal_my_orders" name="Partner Orders Layout">
        <xpath expr="//t[@t-call='portal.portal_searchbar']" position="replace"><section class="lt-portal-list"><nav class="lt-portal-breadcrumb"><a href="/">Home</a><span>/</span><a href="/my">Overview</a><span>/</span>Orders</nav><header class="lt-portal-heading"><h1>Orders</h1><p>Track confirmed orders, payment attempts and actions still requiring payment.</p></header><div class="lt-portal-tabs"><a class="is-active" href="/my/orders">Orders &amp; Payments</a><a href="/my/quotes">Quotations</a></div><t t-call="portal.portal_searchbar"><t t-set="title" t-value="''"/></t></section></xpath>
        <xpath expr="//t[@t-if='orders'][@t-call='portal.portal_table']" position="replace">
            <div t-if="orders" class="lt-portal-card lt-table-card"><div class="table-responsive"><table class="lt-data-table"><thead><tr><th>Order No.</th><th>Date</th><th>Amount</th><th>Status</th><th/></tr></thead><tbody><tr t-foreach="orders" t-as="order"><t t-set="current_tx" t-value="order.get_portal_last_transaction()"/><td><a t-att-href="order.get_portal_url()"><strong t-out="order.name"/></a></td><td><span t-field="order.date_order" t-options="{'widget':'date'}"/></td><td><strong t-field="order.amount_total"/></td><td><span t-if="order.state == 'sale'" class="lt-status-badge lt-status-badge--sale">Confirmed</span><span t-elif="order.state == 'cancel'" class="lt-status-badge lt-status-badge--payment_cancelled">Order Cancelled</span><span t-elif="current_tx and current_tx.state in ('pending', 'authorized')" class="lt-status-badge lt-status-badge--payment_pending">Payment Pending</span><span t-elif="current_tx and current_tx.state == 'error'" class="lt-status-badge lt-status-badge--payment_failed">Payment Failed</span><span t-elif="current_tx and current_tx.state == 'cancel'" class="lt-status-badge lt-status-badge--payment_cancelled">Payment Cancelled</span><span t-else="" class="lt-status-badge lt-status-badge--awaiting_payment">Awaiting Payment</span></td><td class="text-end"><a class="lt-table-link" t-att-href="order.get_portal_url()"><t t-if="order.state in ('draft', 'sent') and current_tx and current_tx.state in ('error', 'cancel', 'draft')">Complete payment →</t><t t-elif="order.state in ('draft', 'sent') and current_tx and current_tx.state in ('pending', 'authorized')">View status →</t><t t-else="">View →</t></a></td></tr></tbody></table></div></div>
        </xpath>
    </template>

    <template id="portal_quotes_figma" inherit_id="sale.portal_my_quotations" name="Partner Quotations Layout">
        <xpath expr="//t[@t-call='portal.portal_searchbar']" position="replace"><section class="lt-portal-list"><nav class="lt-portal-breadcrumb"><a href="/">Home</a><span>/</span><a href="/my">Overview</a><span>/</span>Orders</nav><header class="lt-portal-heading"><h1>Orders</h1><p>View your sales orders and quotations.</p></header><div class="lt-portal-tabs"><a href="/my/orders">Sales Orders</a><a class="is-active" href="/my/quotes">Quotations</a></div><t t-call="portal.portal_searchbar"><t t-set="title" t-value="''"/></t></section></xpath>
    </template>

    <template id="portal_personal_profile_figma" inherit_id="portal.portal_my_details" name="Partner Personal Profile" priority="90">
        <xpath expr="//div[hasclass('o_customer_address_fill')]" position="attributes"><attribute name="class" add="lt-profile-page" separator=" "/></xpath>
        <xpath expr="//div[hasclass('o_customer_address_fill')]" position="before"><nav class="lt-portal-breadcrumb"><a href="/">Home</a><span>/</span><a href="/my">Overview</a><span>/</span>Personal Profile</nav><header class="lt-portal-heading"><h1>Personal Profile</h1><p>Update your personal contact details and primary address.</p></header></xpath>
    </template>

    <template id="portal_addresses_figma" inherit_id="portal.my_addresses" name="Partner Addresses" priority="90">
        <xpath expr="//section[hasclass('o_portal_addresses')]" position="attributes"><attribute name="class" add="lt-addresses-page" separator=" "/></xpath>
        <xpath expr="//section[hasclass('o_portal_addresses')]" position="before"><nav class="lt-portal-breadcrumb"><a href="/">Home</a><span>/</span><a href="/my">Overview</a><span>/</span>Addresses</nav><header class="lt-portal-heading"><h1>Addresses</h1><p>Billing and delivery addresses used for orders and shipments.</p></header></xpath>
    </template>

    <template id="portal_address_management_figma" inherit_id="portal.address_management" name="Partner Address Management" priority="90">
        <xpath expr="//div[hasclass('o_customer_address_fill')]" position="attributes"><attribute name="class" add="lt-profile-page" separator=" "/></xpath>
        <xpath expr="//div[hasclass('o_customer_address_fill')]" position="before"><nav class="lt-portal-breadcrumb"><a href="/">Home</a><span>/</span><a href="/my">Overview</a><span>/</span><a href="/my/addresses">Addresses</a><span>/</span><t t-out="'Billing address' if address_type == 'billing' else 'Delivery address'"/></nav><header class="lt-portal-heading"><h1 t-out="'Billing address' if address_type == 'billing' else 'Delivery address'"/><p>Update the address used for orders and shipments.</p></header></xpath>
    </template>

    <template id="sale_order_figma" inherit_id="sale.sale_order_portal_template" name="Partner Order Detail Layout" priority="90">
        <xpath expr="//div[hasclass('o_portal_sale_sidebar')]" position="attributes"><attribute name="class" add="lt-order-detail" separator=" "/></xpath>
        <xpath expr="//div[hasclass('o_portal_sale_sidebar')]" position="before"><nav class="lt-portal-breadcrumb"><a href="/">Home</a><span>/</span><a href="/my">Overview</a><span>/</span><a href="/my/orders">Orders</a><span>/</span><t t-out="sale_order.name"/></nav><header class="lt-portal-heading"><h1><t t-out="sale_order.name"/></h1><p>Native Odoo order data, payment actions and fulfilment tracking.</p></header></xpath>
    </template>

    <template id="helpdesk_list_figma" inherit_id="helpdesk.portal_helpdesk_ticket" name="Partner Service Ticket List">
        <xpath expr="//t[@t-call='portal.portal_searchbar']" position="replace"><section class="lt-portal-list"><nav class="lt-portal-breadcrumb"><a href="/">Home</a><span>/</span><a href="/my">Overview</a><span>/</span>Service Tickets</nav><header class="lt-portal-heading lt-portal-heading--action"><div><h1>Service Tickets</h1><p>Track your after-sales support and technical helpdesk requests.</p></div><a class="lt-btn lt-btn--blue" href="/service">+ New Request</a></header><t t-call="portal.portal_searchbar"><t t-set="title" t-value="''"/></t></section></xpath>
    </template>

    <template id="helpdesk_detail_figma" inherit_id="helpdesk.tickets_followup" name="Partner Service Ticket Detail">
        <xpath expr="//div[hasclass('o_project_portal_sidebar')]" position="attributes"><attribute name="class" add="lt-ticket-detail" separator=" "/></xpath>
        <xpath expr="//div[hasclass('o_project_portal_sidebar')]" position="before"><nav class="lt-portal-breadcrumb"><a href="/">Home</a><span>/</span><a href="/my">Overview</a><span>/</span><a href="/my/tickets">Service Tickets</a><span>/</span><t t-out="ticket.ticket_ref"/></nav><header class="lt-portal-heading"><h1><t t-out="ticket.name"/></h1><p>Ticket #<t t-out="ticket.ticket_ref"/> · <t t-out="ticket.stage_id.name"/></p></header></xpath>
    </template>

    <template id="checkout_layout_figma_shell" inherit_id="website_sale.checkout_layout" name="Partner Checkout Shell" priority="90">
        <xpath expr="//div[@id='wrap']" position="before"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="b2b_website.partner_topbar"/></xpath>
        <xpath expr="//div[@id='wrap']" position="attributes"><attribute name="class" add="lt-native-checkout" separator=" "/></xpath>
    </template>

    <template id="cart_figma" inherit_id="website_sale.cart" name="Partner Cart">
        <xpath expr="//div[@id='shop_cart']" position="attributes"><attribute name="class" add="lt-cart-page" separator=" "/></xpath>
        <xpath expr="//div[@id='shop_cart']/*[1]" position="before"><div class="lt-checkout-heading"><span class="lt-kicker">ORDER</span><h1>Shopping cart</h1><p>Review products and quantities before checkout.</p></div></xpath>
    </template>

    <template id="checkout_figma" inherit_id="website_sale.checkout" name="Partner Checkout">
        <xpath expr="//div[@id='shop_checkout']" position="attributes"><attribute name="class" add="lt-checkout-page" separator=" "/></xpath>
        <xpath expr="//div[@id='shop_checkout']/*[1]" position="before">
            <div class="lt-checkout-progress" aria-label="Checkout progress">
                <span class="is-active"><b>1</b>Customer</span><span><b>2</b>Billing</span><span><b>3</b>Shipping</span><span><b>4</b>Delivery</span><span><b>5</b>Payment</span><span><b>6</b>Review</span>
            </div>
        </xpath>
    </template>

    <template id="confirmation_figma" inherit_id="website_sale.confirmation" name="Partner Order Confirmation">
        <xpath expr="//div[@id='order_name']" position="attributes"><attribute name="class" add="lt-confirmation-page" separator=" "/></xpath>
        <xpath expr="//div[@id='order_name']" position="before"><div class="lt-confirmation-mark"><i class="fa fa-check"/><span class="lt-kicker">ORDER CONFIRMED</span></div></xpath>
    </template>

    <template id="contactus_figma" inherit_id="website.contactus" name="Partner Contact Page" priority="90">
        <xpath expr="//div[@id='wrap']" position="before"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="b2b_website.partner_topbar"/></xpath>
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty lt-contact-page">
                <section class="lt-page-hero lt-page-hero--compact"><div class="container"><nav class="lt-breadcrumb lt-breadcrumb--dark" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Contact</span></nav><h1>Get in touch with our sales, technical support and partner service teams.</h1><p>Tell us what you need, and the right member of our team will get back to you.</p></div></section>
                <section class="lt-section lt-section--soft"><div class="container lt-contact-layout">
                    <div class="lt-contact-card"><h2>Send a Message</h2><form action="/website/form/" method="post" class="s_website_form o_mark_required lt-contact-form" data-mark="*" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus-thank-you">
                        <input type="hidden" name="email_to" t-att-value="request.env.company.email"/>
                        <div class="lt-form-grid"><div class="lt-field"><label for="contact-name">Full Name *</label><input id="contact-name" class="s_website_form_input" name="name" placeholder="Your name" required="required"/></div><div class="lt-field"><label for="contact-email">Business Email *</label><input id="contact-email" class="s_website_form_input" name="email_from" type="email" placeholder="name@company.com" required="required"/></div><div class="lt-field"><label for="contact-company">Company</label><input id="contact-company" class="s_website_form_input" name="company" placeholder="Company name"/></div><div class="lt-field"><label for="contact-subject">Message Type</label><select id="contact-subject" class="s_website_form_input" name="subject"><option value="Sales inquiry">Select message type...</option><option>Sales Inquiry</option><option>Technical Support</option><option>Sample Request</option><option>Partnership</option><option>Other</option></select></div><div class="lt-field lt-field--wide"><label for="contact-message">Message *</label><textarea id="contact-message" class="s_website_form_input" name="description" placeholder="Describe your request, including product names, quantities and application requirements..." required="required"/></div></div>
                        <a href="#" role="button" class="lt-btn lt-btn--blue s_website_form_send">Send Message <i class="fa fa-arrow-right"/></a><span class="s_website_form_result"/>
                    </form></div>
                    <aside class="lt-contact-aside"><section><h3>Contact Channels</h3><article><i class="fa fa-envelope-o"/><div><strong>Sales Inquiry</strong><p>Product pricing, bulk orders and partnerships</p><a t-att-href="'mailto:%s' % (request.env.company.email or 'sales@luckytone.com')" t-out="request.env.company.email or 'sales@luckytone.com'"/></div></article><article><i class="fa fa-wrench"/><div><strong>Technical Support</strong><p>Technical specifications, installation and troubleshooting</p><a t-att-href="'/service-center' if not request.env.user._is_public() else '/web/login?redirect=/service-center'">Open Service Center</a></div></article><article><i class="fa fa-flask"/><div><strong>Sample Requests</strong><p>Request product samples for evaluation</p><a t-att-href="'/samples' if not request.env.user._is_public() else '/web/login?redirect=/samples'">Open Sample Center</a></div></article><article><i class="fa fa-handshake-o"/><div><strong>Partner Program</strong><p>Distributor and reseller partnerships</p><a href="/partner-application">Apply for Partnership</a></div></article></section><section><h3>Headquarters</h3><strong t-out="request.env.company.name"/><p t-out="request.env.company.partner_id.contact_address or 'Contact us for our current office address.'"/><p t-if="request.env.company.phone"><i class="fa fa-phone"/> <t t-out="request.env.company.phone"/></p></section></aside>
                </div></section>
                <t t-call="b2b_website.partner_footer"/>
            </div>
        </xpath>
    </template>

    <template id="login_layout_figma" inherit_id="web.login" name="Partner Hub Login">
        <xpath expr="//form" position="attributes">
            <attribute name="t-attf-class">oe_login_form #{'' if login else 'd-none'} lt-login-card lt-auth-login-form</attribute>
            <attribute name="data-captcha"/>
        </xpath>
        <xpath expr="//form" position="before"><div class="lt-login-heading"><span class="lt-kicker">POWER &amp; GRACE PARTNER HUB</span><h1>Sign in to your account</h1><p>Access pricing, orders, samples and support.</p></div></xpath>
        <xpath expr="//div[hasclass('o_caps_lock_warning')]" position="after">
            <label class="lt-remember-me"><input type="checkbox" name="remember" value="1"/><span>Remember me</span></label>
        </xpath>
    </template>

    <template id="login_signup_link_figma" inherit_id="auth_signup.login" name="Partner Hub Login Signup Link">
        <xpath expr="//a[@t-if='signup_enabled']" position="replace">
            <p t-if="signup_enabled" class="lt-login-create-account">Don't have an account? <a t-attf-href="/web/signup?{{ keep_query() }}">Create an account</a></p>
        </xpath>
    </template>

    <template id="login_oauth_divider_figma" inherit_id="web.login_oauth" name="Partner Hub Login Divider">
        <xpath expr="//em" position="replace"><div class="lt-login-divider"><span>or</span></div></xpath>
    </template>

    <template id="website_login_shell_figma" inherit_id="website.login_layout" name="Partner Hub Authentication Shell" priority="90">
        <xpath expr="//t[@t-call='website.layout']" position="replace"><t t-call="b2b_website.partner_auth_layout"><div class="oe_website_login_container" t-out="0"/></t></xpath>
    </template>

    <template id="signup_figma" inherit_id="auth_signup.signup" name="Partner Hub Registration">
        <xpath expr="//form" position="replace">
            <section t-if="message" class="lt-registration-result" role="status">
                <span class="lt-registration-result__icon"><i class="fa fa-envelope-o"/></span>
                <span class="lt-kicker">POWER &amp; GRACE PARTNER HUB</span>
                <h1>Verify your business email</h1>
                <p t-out="message"/>
                <p t-if="signup_email"><strong t-out="signup_email"/></p>
                <form t-if="signup_email" action="/web/signup/resend" method="post" class="lt-resend-form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="email" t-att-value="signup_email"/>
                    <button type="submit" class="lt-btn lt-btn--outline">Resend verification email</button>
                </form>
                <a class="lt-auth-text-link" href="/web/login">Return to sign in</a>
            </section>

            <form t-elif="token" class="oe_signup_form lt-login-card" role="form" method="post" data-captcha="signup">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="lt-login-heading"><span class="lt-kicker">POWER &amp; GRACE PARTNER HUB</span><h1>Activate your invited account</h1><p>Set your password to accept the portal invitation.</p></div>
                <div class="mb-3 field-name"><label for="name" class="form-label">Name</label><input type="text" name="name" t-att-value="name" id="name" class="form-control" required="required"/></div>
                <div class="mb-3 field-login"><label for="login" class="form-label">Email</label><input type="email" name="login" t-att-value="login" id="login" class="form-control" required="required" readonly="readonly"/></div>
                <t t-call="auth_signup.fields"><t t-set="autofocus" t-value="1"/></t>
                <p class="alert alert-danger" t-if="error" role="alert"><t t-esc="error"/></p>
                <input type="hidden" name="redirect" t-att-value="redirect"/>
                <input type="hidden" name="token" t-att-value="token"/>
                <div class="oe_login_buttons d-grid pt-3"><button type="submit" class="btn btn-primary">Activate account</button></div>
            </form>

            <form t-else="" class="oe_signup_form lt-registration-form" role="form" method="post" data-captcha="signup">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <header class="lt-registration-heading">
                    <span class="lt-kicker">POWER &amp; GRACE PARTNER HUB</span>
                    <h1>Create Your Partner Account</h1>
                    <p>Tell us a little about you and your company.<br/>Your account will be reviewed before partner access is activated.</p>
                </header>
                <div class="lt-registration-body">
                    <section>
                        <h2>Contact &amp; Company Information</h2>
                        <div class="lt-registration-grid">
                            <div class="lt-field"><label for="name">Full Name <b>*</b></label><input type="text" name="name" t-att-value="name" id="name" placeholder="John Doe" maxlength="160" autocomplete="name" required="required"/></div>
                            <div class="lt-field"><label for="job_title">Job Title <b>*</b></label><input type="text" name="job_title" t-att-value="job_title" id="job_title" placeholder="Sales Manager" maxlength="160" autocomplete="organization-title" required="required"/></div>
                            <div class="lt-field"><label for="company_name">Company Name <b>*</b></label><input type="text" name="company_name" t-att-value="company_name" id="company_name" placeholder="Company name" maxlength="200" autocomplete="organization" required="required"/></div>
                            <div class="lt-field"><label for="country_id">Country / Region <b>*</b></label><select name="country_id" id="country_id" autocomplete="country" required="required"><option value="">Select country</option><option t-foreach="countries" t-as="country" t-att-value="country.id" t-att-selected="str(country.id) == str(country_id or '')" t-out="country.name"/></select></div>
                            <div class="lt-field"><label for="login">Business Email <b>*</b></label><input type="email" name="login" t-att-value="login" id="login" placeholder="name@company.com" maxlength="254" autocomplete="email" autocapitalize="off" required="required"/></div>
                            <div class="lt-field"><label for="company_phone">Company Phone</label><input type="tel" name="company_phone" t-att-value="company_phone" id="company_phone" placeholder="+1 000 000 0000" maxlength="64" autocomplete="tel"/></div>
                            <div class="lt-field"><label for="mobile">Mobile / WhatsApp <b>*</b></label><input type="tel" name="mobile" t-att-value="mobile" id="mobile" placeholder="+1 000 000 0000" maxlength="64" autocomplete="tel" required="required"/></div>
                            <div class="lt-field"><label for="customer_type_id">Business Type <b>*</b></label><select name="customer_type_id" id="customer_type_id" required="required"><option value="">Select business type</option><option t-foreach="customer_types" t-as="customer_type" t-att-value="customer_type.id" t-att-selected="str(customer_type.id) == str(customer_type_id or '')" t-out="customer_type.name"/></select></div>
                            <div class="lt-field"><label for="company_website">Company Website</label><input type="text" name="company_website" t-att-value="company_website" id="company_website" placeholder="www.company.com" maxlength="500" autocomplete="url"/></div>
                            <div class="lt-field"><label for="product_interest_id">Products of Interest</label><select name="product_interest_id" id="product_interest_id"><option value="">Select products</option><option t-foreach="product_interests" t-as="interest" t-att-value="interest.id" t-att-selected="str(interest.id) == str(product_interest_id or '')" t-out="interest.name"/></select></div>
                        </div>
                    </section>
                    <section class="lt-registration-security">
                        <h2>Account Security</h2>
                        <div class="lt-registration-grid">
                            <div class="lt-field o_caps_lock_warning"><label for="password">Password <b>*</b></label><div class="input-group lt-password-field"><input type="password" name="password" id="password" placeholder="••••••••••••" required="required" autocomplete="new-password" maxlength="4096"/><button type="button" class="o_show_password" aria-label="Show password"><i class="fa fa-eye"/></button></div></div>
                            <div class="lt-field"><label for="confirm_password">Confirm Password <b>*</b></label><div class="input-group lt-password-field"><input type="password" name="confirm_password" id="confirm_password" placeholder="••••••••••••" required="required" autocomplete="new-password" maxlength="4096"/><button type="button" class="o_show_password" aria-label="Show password"><i class="fa fa-eye"/></button></div></div>
                        </div>
                    </section>
                    <div class="lt-registration-actions">
                        <label class="lt-registration-terms"><input type="checkbox" name="terms" value="1" t-att-checked="terms == '1'" required="required" data-lt-validation-message="Please accept the Terms of Use and Privacy Policy."/><span>I agree to the <a href="/terms-of-use" target="_blank">Terms of Use</a> and <a href="/privacy" target="_blank">Privacy Policy</a>.</span></label>
                        <p class="alert alert-danger" t-if="error" role="alert"><t t-esc="error"/></p>
                        <input type="hidden" name="redirect" t-att-value="redirect"/>
                        <button type="submit" class="lt-registration-submit">Submit for Approval</button>
                        <p class="lt-registration-email-note"><i class="fa fa-envelope-o"/><span>We'll send a verification link to your email.<br/>Please confirm your email to complete registration.</span></p>
                    </div>
                </div>
                <footer class="lt-registration-footer">
                    <p>Already have an account? <a href="/web/login">Sign in</a></p>
                    <ol class="lt-registration-progress">
                        <li><b>1</b><span>Submit</span></li><li><b>2</b><span>Verify Email</span></li><li><b>3</b><span>Partner Review</span></li><li><b>4</b><span>Access Activated</span></li>
                    </ol>
                </footer>
            </form>
        </xpath>
    </template>

    <template id="reset_password_figma" inherit_id="auth_signup.reset_password" name="Partner Hub Password Reset">
        <xpath expr="//form" position="attributes"><attribute name="class" add="lt-login-card" separator=" "/></xpath>
        <xpath expr="//form" position="before"><div class="lt-login-heading"><span class="lt-kicker">POWER &amp; GRACE PARTNER HUB</span><h1>Reset your password</h1><p>We will send recovery instructions to your registered email.</p></div></xpath>
    </template>

    <template id="registration_status" name="Partner Registration Status">
        <t t-call="b2b_website.partner_auth_layout">
            <section class="lt-registration-result" role="status">
                <span t-att-class="'lt-registration-result__icon ' + ('is-success' if status == 'verified' else '')"><i t-att-class="'fa ' + ('fa-check' if status == 'verified' else 'fa-envelope-o')"/></span>
                <span class="lt-kicker">POWER &amp; GRACE PARTNER HUB</span>
                <t t-if="status == 'verified'"><h1>Email verified</h1><p>Your account is active and your application is ready for partner review. You can sign in now to follow its status.</p><a class="lt-btn lt-btn--blue" href="/web/login?redirect=/my">Sign in</a></t>
                <t t-elif="status == 'expired'"><h1>Verification link expired</h1><p>Request a new link to continue your registration.</p><form action="/web/signup/resend" method="post" class="lt-resend-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="email" t-att-value="email"/><button type="submit" class="lt-btn lt-btn--blue">Send a new link</button></form></t>
                <t t-elif="status == 'resent'"><h1>Check your email</h1><p t-out="message"/><a class="lt-auth-text-link" href="/web/login">Return to sign in</a></t>
                <t t-else=""><h1>Verification link unavailable</h1><p>This link is invalid or has already been used. If your email was already verified, sign in to continue.</p><a class="lt-btn lt-btn--blue" href="/web/login">Sign in</a></t>
            </section>
        </t>
    </template>
</odoo>
