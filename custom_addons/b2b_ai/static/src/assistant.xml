<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="b2b_ai.FloatingAssistant">
    <aside t-if="state.enabled" class="lt-ai-widget" t-on-keydown="keydown">
        <button class="ai-launcher" type="button" t-ref="launcher" t-on-click="toggle" aria-label="AI Assistant" t-att-aria-expanded="state.open ? 'true' : 'false'" aria-controls="lt-ai-window"><i class="fa fa-comment-o" aria-hidden="true"/><span>AI Assistant</span></button>
        <section t-if="state.open" id="lt-ai-window" class="ai-window" t-att-class="{'ai-expanded': state.expanded}" role="dialog" aria-modal="false" aria-label="AI Assistant chat">
            <header class="ai-header"><div><strong>AI Assistant</strong><span>Products, project advice and technical answers</span></div><button type="button" t-on-click="expand" t-att-aria-label="state.expanded ? 'Reduce chat' : 'Expand chat'"><i t-att-class="state.expanded ? 'fa fa-compress' : 'fa fa-expand'" aria-hidden="true"/></button><button type="button" t-on-click="close" aria-label="Minimize chat"><i class="fa fa-minus" aria-hidden="true"/></button></header>
            <div t-if="!state.loaded" class="ai-scroll"><p>Connecting to your assistant…</p><p role="alert" t-esc="state.error"/><button type="button" t-on-click="retry">Retry connection</button></div>
            <div t-elif="!state.signedIn" class="ai-scroll ai-welcome"><h3>Welcome to your partner assistant</h3><p>Sign in to get advice with your product access and customer prices.</p><a t-att-href="loginUrl" t-on-click="close" class="ai-primary-link">Sign in</a><p><a href="/contact">Contact our team</a></p></div>
            <t t-else="">
                <nav class="ai-toolbar" aria-label="Chat tools"><button type="button" t-on-click="showHistory" t-att-disabled="state.busy">History</button><button type="button" t-on-click="newConversation" t-att-disabled="state.busy">New chat</button><button t-if="state.project" type="button" t-on-click="showFacts" t-att-disabled="state.busy || thinking">Project requirements</button></nav>
                <div t-if="!state.ready" class="ai-notice" role="status">Our assistant is being prepared. <a href="/contact">Contact our team</a> for help now.</div>
                <div t-if="state.error" class="ai-error" role="alert"><span t-esc="state.error"/><button type="button" t-on-click="retry" t-att-disabled="state.busy">Retry / refresh</button></div>
                <div t-if="state.notice" class="ai-notice" role="status" t-esc="state.notice"/>
                <div t-if="state.panel === 'history'" class="ai-scroll"><div class="ai-section-title"><h3>Your conversations</h3><button type="button" t-on-click="back">Back</button></div><p class="ai-small">Private to your login, not shared with other company contacts.</p><p t-if="!state.projects.length">No saved conversations yet.</p><button t-foreach="state.projects" t-as="project" t-key="project.id" type="button" class="ai-history-item" t-on-click="() => this.select(project.id)" t-att-disabled="state.busy"><i class="fa fa-comment-o" aria-hidden="true"/><span t-esc="project.name"/></button></div>
                <div t-elif="state.panel === 'facts'" class="ai-scroll"><div class="ai-section-title"><h3>Project requirements</h3><button type="button" t-on-click="back">Back</button></div><p class="ai-small">Correct these details to keep future answers in context.</p><form t-on-submit="saveFacts" class="ai-facts"><label t-foreach="factKeys" t-as="key" t-key="key"><span t-esc="label(key)"/><input type="text" maxlength="500" t-model="state.facts[key]"/></label><button type="submit" class="ai-primary-link" t-att-disabled="state.busy || thinking">Save requirements</button></form><button type="button" class="ai-archive" t-on-click="archive" t-att-disabled="state.busy"><t t-esc="state.confirmDelete ? 'Confirm archive conversation' : 'Archive conversation'"/></button></div>
                <t t-else="">
                    <div class="ai-scroll ai-messages" t-ref="history" role="log" aria-live="polite" aria-label="Conversation messages">
                        <div t-if="!state.project || !state.project.turns.length" class="ai-welcome"><span class="ai-welcome-icon"><i class="fa fa-commenting-o" aria-hidden="true"/></span><h3>What are you working on?</h3><p>Tell me about your project or ask a product question. You can keep browsing while we talk.</p><button type="button" t-on-click="() => this.example('Need speakers for an airport.')">Find products for my project <span>→</span></button><button type="button" t-on-click="() => this.example('How do I connect my Dante equipment?')">Ask a technical question <span>→</span></button></div>
                        <t t-if="state.project"><article t-foreach="state.project.turns" t-as="turn" t-key="turn.id" class="ai-turn"><div class="ai-user"><small>You</small><p t-esc="turn.question"/></div><div class="ai-answer"><small>AI Assistant</small>
                            <p t-if="turn.state === 'queued'" role="status">Your question is saved. Preparing your reply — you can continue browsing.</p>
                            <p t-elif="turn.state === 'running'" role="status">Checking the approved product and technical information…</p>
                            <t t-elif="turn.state === 'failed'"><p>We could not complete this reply. Please retry or contact our team.</p><button type="button" t-on-click="() => this.example(turn.question)">Use this question again</button></t>
                            <t t-else=""><div t-foreach="turn.answer.points" t-as="point" t-key="point_index" class="ai-point"><p t-esc="point.text"/><details><summary>Supporting evidence</summary><blockquote t-esc="point.evidence_quote"/></details></div><p t-if="turn.answer.question" t-esc="turn.answer.question"/><div t-foreach="turn.answer.products" t-as="product" t-key="product.id" class="ai-product"><a t-att-href="safeUrl(product.url)" t-esc="product.name"/><span t-if="product.model" t-esc="product.model"/><strong t-esc="product.price"/><span>Minimum order: <t t-esc="product.moq"/></span><small t-esc="product.price_note"/><a t-att-href="safeUrl(product.url)">View product →</a></div><div t-if="turn.answer.sources.length" class="ai-sources"><small>Approved resources</small><a t-foreach="turn.answer.sources" t-as="source" t-key="source.id" t-att-href="safeUrl(source.url)" t-esc="source.name"/></div></t>
                        </div></article></t>
                    </div>
                    <form class="ai-compose" t-on-submit="send"><label for="lt-ai-question">Your message</label><div class="ai-input-row"><textarea id="lt-ai-question" t-ref="input" rows="2" maxlength="3000" t-model="state.draft" t-on-input="inputChanged" placeholder="Ask about products or your project…"/><button type="submit" aria-label="Send message" t-att-disabled="!canSend"><i class="fa fa-arrow-up" aria-hidden="true"/></button></div><small>AI guidance needs final confirmation. No passwords or payment details. <a href="/contact">Contact our team</a>.</small></form>
                </t>
            </t>
        </section>
    </aside>
</t>
</templates>
