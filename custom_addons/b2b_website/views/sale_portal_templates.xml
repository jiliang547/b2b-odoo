<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_portal_erp_tracking" inherit_id="sale.sale_order_portal_template" name="Partner ERP Tracking">
        <xpath expr="//div[@id='sale_order_sidebar_button']" position="inside">
            <a t-if="sale_order.state in ('sale', 'done')" class="btn btn-outline-primary" t-att-href="'/my/orders/%s/erp-status' % sale_order.id"><i class="fa fa-truck me-1"/> Track ERP fulfilment</a>
        </xpath>
    </template>
</odoo>
