<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="faq_page" name="Partner Hub FAQ">
        <t t-call="b2b_website.partner_layout">
            <section class="pg-info-hero"><div class="container"><nav class="pg-breadcrumb"><a href="/">Home</a><span>/</span><b>FAQ</b></nav><span class="pg-info-hero__eyebrow">SUPPORT CENTER</span><h1>Frequently Asked Questions</h1><p>Find quick answers about partner accounts, pricing, orders, samples, warranty, delivery, and downloads.</p><label class="pg-faq-search"><i class="fa fa-search"/><input type="search" data-pg-faq-search="" placeholder="Search questions and answers…" aria-label="Search frequently asked questions"/></label></div></section>
            <section class="pg-info-section"><div class="container pg-faq-layout" data-pg-faq="">
                <aside class="pg-faq-categories" aria-label="FAQ categories"><button type="button" class="is-active" data-pg-faq-category="all">All Questions</button><button t-foreach="faq_categories" t-as="category" type="button" t-att-data-pg-faq-category="category.id" t-out="category.name"/></aside>
                <div class="pg-faq-content"><div class="pg-faq-empty" data-pg-faq-empty="" hidden="hidden"><h2>No matching questions</h2><p>Try a different search, or contact our sales team for help.</p></div><details t-foreach="faq_items" t-as="item" class="pg-faq-item" t-att-data-pg-faq-item="item.category_id.id" t-att-data-pg-faq-text="('%s %s' % (item.question, item.answer)).lower()"><summary><span t-out="item.question"/><i class="fa fa-plus"/></summary><div class="pg-faq-item__answer"><div t-field="item.answer"/><a t-if="item.action_label and item.action_url" class="lt-btn lt-btn--outline lt-btn--small" t-att-href="item.action_url" t-out="item.action_label"/></div></details></div>
            </div></section>
            <section class="pg-info-cta"><div class="container"><div><h2>Still need help?</h2><p>Continue an existing conversation or ask our team a new question.</p></div><div class="lt-actions"><a class="lt-btn lt-btn--lime" href="/contact">Contact Sales</a><a class="lt-btn lt-btn--light" t-att-href="'/my/inquiries' if not request.env.user._is_public() else '/web/login?redirect=/my/inquiries'">View My Inquiries</a></div></div></section>
        </t>
    </template>

    <template id="shipping_page" name="Shipping Costs and Delivery Times">
        <t t-call="b2b_website.partner_layout">
            <section class="pg-info-hero"><div class="container"><nav class="pg-breadcrumb"><a href="/">Home</a><span>/</span><b>Shipping &amp; Delivery</b></nav><span class="pg-info-hero__eyebrow">LOGISTICS</span><h1>Shipping Costs &amp; Delivery Times</h1><p>Plan your project with clear production lead times and international freight options.</p></div></section>
            <section class="pg-info-section"><div class="container"><div class="pg-section-heading"><div><h2>Shipping Methods</h2></div></div><div class="pg-shipping-grid"><article><i class="fa fa-plane"/><h3>Express Air Freight</h3><p>Fast delivery for samples, urgent parts, and smaller shipments.</p><strong>Typically 3–7 business days</strong></article><article><i class="fa fa-plane"/><h3>Standard Air Freight</h3><p>Balanced speed and cost for medium-sized commercial orders.</p><strong>Typically 7–12 business days</strong></article><article><i class="fa fa-ship"/><h3>LCL Sea Freight</h3><p>Cost-effective shared-container shipping for flexible volumes.</p><strong>Typically 25–40 days</strong></article><article><i class="fa fa-cube"/><h3>FCL Sea Freight</h3><p>Dedicated container shipping for larger wholesale orders.</p><strong>Typically 20–35 days</strong></article></div></div></section>
            <section class="pg-info-section pg-info-section--soft"><div class="container pg-shipping-columns"><div><span class="pg-info-label">PRODUCTION</span><h2>Production Lead Times</h2><div class="pg-lead-times"><article><strong>3–5 days</strong><span>Products currently in stock</span></article><article><strong>7–10 days</strong><span>Standard production orders</span></article><article><strong>10–20 days</strong><span>Custom and OEM configurations</span></article></div></div><div><span class="pg-info-label">TRANSIT</span><h2>Regional Transit Estimates</h2><div class="table-responsive"><table class="pg-transit-table"><thead><tr><th>Destination</th><th>Air</th><th>Sea</th></tr></thead><tbody><tr><td>Asia Pacific</td><td>3–8 days</td><td>12–25 days</td></tr><tr><td>Europe</td><td>7–12 days</td><td>25–40 days</td></tr><tr><td>North America</td><td>7–14 days</td><td>25–40 days</td></tr><tr><td>Middle East &amp; Africa</td><td>7–14 days</td><td>25–45 days</td></tr></tbody></table></div></div></div></section>
            <section class="pg-info-section"><div class="container pg-shipping-notes"><h2>Common Questions</h2><details><summary>How is the final shipping cost calculated?<i class="fa fa-plus"/></summary><p>Final freight depends on destination, shipment dimensions, weight, Incoterms, and the selected carrier. The confirmed amount is shown in your quotation or checkout.</p></details><details><summary>Can I use my own freight forwarder?<i class="fa fa-plus"/></summary><p>Yes. Provide your forwarder's details to our sales team before the order is released for shipment.</p></details><details><summary>Can production and transit times change?<i class="fa fa-plus"/></summary><p>These are planning estimates. Your quotation and confirmed order contain the applicable lead time for the selected products and destination.</p></details></div></section>
            <section class="pg-info-cta"><div class="container"><div><h2>Need a shipping estimate?</h2><p>Share your products, quantities, destination, and preferred delivery date.</p></div><div class="lt-actions"><a class="lt-btn lt-btn--lime" href="/contact">Contact Sales</a><a class="lt-btn lt-btn--light" href="/faq">View FAQ</a></div></div></section>
        </t>
    </template>
</odoo>
