<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_b2b_customer_segment_list" model="ir.ui.view">
        <field name="name">b2b.customer.segment.list</field>
        <field name="model">b2b.customer.segment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="priority"/>
                <field name="partner_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_b2b_customer_segment_form" model="ir.ui.view">
        <field name="name">b2b.customer.segment.form</field>
        <field name="model">b2b.customer.segment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_partners" class="oe_stat_button" icon="fa-users">
                            <field name="partner_count" widget="statinfo" string="Customers"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="name"/>
                        <field name="priority"/>
                        <field name="sequence"/>
                    </group>
                    <field name="description" placeholder="Business meaning and intended visibility rules..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_b2b_customer_segments" model="ir.actions.act_window">
        <field name="name">Customer Segments</field>
        <field name="res_model">b2b.customer.segment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
