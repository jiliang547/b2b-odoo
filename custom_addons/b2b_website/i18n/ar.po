#. module: b2b_website
#: model:mail.template,body_html:b2b_website.mail_template_registration_verify
msgid ""
"<div style=\"font-family:Arial,sans-serif;color:#111827;line-height:1.6\">\n"
"                    <p>Dear <t t-out=\"object.full_name\"/>,</p>\n"
"                    <p>Thank you for registering with the POWER &amp; GRACE Partner Hub. Confirm your business email before our partner team reviews your application.</p>\n"
"                    <p style=\"margin:24px 0\"><a t-att-href=\"object.get_verification_url()\" style=\"background:#E8380C;color:#fff;text-decoration:none;padding:12px 22px;border-radius:6px;font-weight:700\">Verify Email</a></p>\n"
"                    <p>This link expires in 24 hours. If you did not submit this registration, you can ignore this email.</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"font-family:Arial,sans-serif;color:#111827;line-height:1.6\">\n"
"                    <p>مرحبًا <t t-out=\"object.full_name\"/>,</p>\n"
"                    <p>شكرًا لتسجيلك في بوابة شركاء POWER &amp; GRACE. أكد بريد عملك قبل مراجعة فريق الشركاء لطلبك.</p>\n"
"                    <p style=\"margin:24px 0\"><a t-att-href=\"object.get_verification_url()\" style=\"background:#E8380C;color:#fff;text-decoration:none;padding:12px 22px;border-radius:6px;font-weight:700\">التحقق من البريد</a></p>\n"
"                    <p>تنتهي صلاحية هذا الرابط خلال 24 ساعة. إذا لم تقدم طلب التسجيل، يمكنك تجاهل هذه الرسالة.</p>\n"
"                </div>\n"
"            "

#. module: b2b_website
#: model:mail.template,body_html:b2b_website.mail_template_registration_rejected
msgid ""
"<div style=\"font-family:Arial,sans-serif;color:#111827;line-height:1.6\">\n"
"                    <p>Dear <t t-out=\"object.full_name\"/>,</p>\n"
"                    <p>We could not approve your Partner Hub registration at this time.</p>\n"
"                    <p><strong>Reason:</strong> <t t-out=\"object.rejection_reason\"/></p>\n"
"                    <p>Please contact our team if the submitted information needs to be corrected.</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"font-family:Arial,sans-serif;color:#111827;line-height:1.6\">\n"
"                    <p>مرحبًا <t t-out=\"object.full_name\"/>,</p>\n"
"                    <p>لم نتمكن من الموافقة على تسجيلك في بوابة الشركاء حاليًا.</p>\n"
"                    <p><strong>السبب:</strong> <t t-out=\"object.rejection_reason\"/></p>\n"
"                    <p>يرجى التواصل مع فريقنا إذا كانت المعلومات المقدمة بحاجة إلى تصحيح.</p>\n"
"                </div>\n"
"            "

#. module: b2b_website
#: model:mail.template,body_html:b2b_website.mail_template_registration_approved
msgid ""
"<div style=\"font-family:Arial,sans-serif;color:#111827;line-height:1.6\">\n"
"                    <p>Dear <t t-out=\"object.full_name\"/>,</p>\n"
"                    <p>Your Partner Hub registration has been approved and your company access is now active.</p>\n"
"                    <p style=\"margin:24px 0\"><a t-att-href=\"object.get_base_url() + '/web/login'\" style=\"background:#E8380C;color:#fff;text-decoration:none;padding:12px 22px;border-radius:6px;font-weight:700\">Sign in to Partner Hub</a></p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"font-family:Arial,sans-serif;color:#111827;line-height:1.6\">\n"
"                    <p>مرحبًا <t t-out=\"object.full_name\"/>,</p>\n"
"                    <p>تمت الموافقة على تسجيلك في بوابة الشركاء وأصبح وصول شركتك مفعّلًا.</p>\n"
"                    <p style=\"margin:24px 0\"><a t-att-href=\"object.get_base_url() + '/web/login'\" style=\"background:#E8380C;color:#fff;text-decoration:none;padding:12px 22px;border-radius:6px;font-weight:700\">تسجيل الدخول إلى بوابة الشركاء</a></p>\n"
"                </div>\n"
"            "

