#: model:mail.template,body_html:b2b_website.mail_template_registration_verify
msgid ""
"<div style=\"font-family:Arial,sans-serif;color:#111827;line-height:1.6\">\n"
"                    <p>Dear <t t-out=\"object.full_name\"/>,</p>\n"
"                    <p>Thank you for registering with the POWER &amp; GRACE Partner Hub. Confirm your business email before our partner team reviews your application.</p>\n"
