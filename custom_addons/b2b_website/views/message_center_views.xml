<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_b2b_message_thread_list" model="ir.ui.view">
        <field name="name">b2b.message.thread.list</field>
        <field name="model">b2b.message.thread</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-bf="is_unread">
                <field name="is_unread" readonly="1"/>
                <field name="last_message_at"/>
                <field name="source_type"/>
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="company_id" optional="show"/>
                <field name="assigned_user_id"/>
                <field name="last_author_id"/>
                <field name="last_message_preview"/>
                <button name="action_open_source" type="object" string="Open" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_b2b_message_thread_search" model="ir.ui.view">
        <field name="name">b2b.message.thread.search</field>
        <field name="model">b2b.message.thread</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="assigned_user_id"/>
                <filter name="my_conversations" string="Assigned to Me" domain="[('assigned_user_id', '=', uid)]"/>
                <separator/>
                <filter name="contact_requests" string="Contact Requests" domain="[('source_model', '=', 'b2b.contact.request')]"/>
                <filter name="orders" string="Orders" domain="[('source_model', '=', 'sale.order')]"/>
                <filter name="samples" string="Samples" domain="[('source_model', '=', 'b2b.sample.request')]"/>
                <filter name="support" string="Support" domain="[('source_model', '=', 'helpdesk.ticket')]"/>
                <filter name="changes" string="Order Changes" domain="[('source_model', '=', 'b2b.order.change.request')]"/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by': 'source_model'}"/>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'commercial_partner_id'}"/>
                    <filter string="Responsible" name="group_responsible" context="{'group_by': 'assigned_user_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_b2b_message_threads" model="ir.actions.act_window">
        <field name="name">Message Center</field>
        <field name="res_model">b2b.message.thread</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_b2b_message_thread_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No customer conversations yet</p>
            <p>Public replies from orders, samples, support, order changes, and contact requests appear here.</p>
        </field>
    </record>
</odoo>
