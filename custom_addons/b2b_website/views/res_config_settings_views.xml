<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_b2b_website" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.b2b.website</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="b2b_core.res_config_settings_view_form_b2b"/>
        <field name="arch" type="xml">
            <block id="b2b_partner_hub_settings" position="inside">
                <setting string="Partner Hub branding" help="The selected website logo is used in the Partner Hub header and footer.">
                    <field name="b2b_website_logo" widget="image" class="oe_avatar"/>
                </setting>
                <setting string="Partner Hub social links" help="Full public profile URLs used by the TikTok, Facebook and LinkedIn footer icons.">
                    <div class="content-group">
                        <div class="row mt8"><label class="col-lg-3" for="b2b_social_tiktok"/><field name="b2b_social_tiktok" placeholder="https://www.tiktok.com/@youraccount"/></div>
                        <div class="row mt8"><label class="col-lg-3" for="b2b_social_facebook"/><field name="b2b_social_facebook" placeholder="https://www.facebook.com/yourpage"/></div>
                        <div class="row mt8"><label class="col-lg-3" for="b2b_social_linkedin"/><field name="b2b_social_linkedin" placeholder="https://www.linkedin.com/company/yourcompany"/></div>
                    </div>
                </setting>
                <setting string="Partner Hub Helpdesk team" help="New repair and replacement requests are assigned to this team.">
                    <field name="b2b_helpdesk_team_id" options="{'no_create': True}"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>
