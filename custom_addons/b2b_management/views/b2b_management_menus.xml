<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_b2b_dashboard" model="ir.actions.client">
        <field name="name">Partner Hub</field><field name="tag">b2b_management.dashboard</field>
    </record>
    <record id="action_b2b_new_contact_requests" model="ir.actions.act_window">
        <field name="name">New Contact Requests</field>
        <field name="res_model">b2b.contact.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="b2b_website.view_b2b_contact_request_search"/>
        <field name="domain">[('state', '=', 'new')]</field>
    </record>
    <record id="action_b2b_pending_registrations" model="ir.actions.act_window">
        <field name="name">Pending Registrations</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_ids.share', '=', True), ('user_ids.active', '=', True), ('commercial_partner_id.b2b_approved', '=', False)]</field>
    </record>
    <record id="action_b2b_partner_applications" model="ir.actions.act_window">
        <field name="name">Partner Applications</field>
        <field name="res_model">b2b.contact.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="b2b_website.view_b2b_contact_request_search"/>
        <field name="domain">[('request_type', '=', 'partnership'), ('state', 'in', ['new', 'in_progress'])]</field>
    </record>
    <record id="action_b2b_failed_integration_jobs" model="ir.actions.act_window">
        <field name="name">ERP Failures</field>
        <field name="res_model">b2b.integration.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="b2b_erp_connector.view_b2b_integration_job_search"/>
        <field name="domain">[('state', 'in', ['failed', 'dead'])]</field>
    </record>
    <menuitem id="menu_b2b_management_root" name="B2B Management" sequence="38" web_icon="b2b_management,static/description/icon.png" groups="b2b_core.group_b2b_operator"/>
    <menuitem id="menu_b2b_dashboard" name="Dashboard" parent="menu_b2b_management_root" action="action_b2b_dashboard" sequence="5"/>
    <menuitem id="menu_b2b_operations" name="Operations" parent="menu_b2b_management_root" sequence="10"/>
    <menuitem id="menu_b2b_samples" name="Sample Requests" parent="menu_b2b_operations" action="b2b_sample.action_b2b_sample_requests" sequence="10"/>
    <menuitem id="menu_b2b_contact_requests" name="Contact Requests" parent="menu_b2b_operations" action="b2b_website.action_b2b_contact_requests" sequence="15"/>
    <menuitem id="menu_b2b_erp_jobs" name="ERP Jobs" parent="menu_b2b_operations" action="b2b_erp_connector.action_b2b_integration_jobs" sequence="20" groups="b2b_core.group_b2b_operator"/>
    <menuitem id="menu_b2b_business_data" name="Business Data" parent="menu_b2b_management_root" sequence="20"/>
    <menuitem id="menu_b2b_customers" name="Customers" parent="menu_b2b_business_data" action="base.action_partner_form" sequence="10"/>
    <menuitem id="menu_b2b_products" name="Products" parent="menu_b2b_business_data" action="product.product_template_action" sequence="20"/>
    <menuitem id="menu_b2b_product_media" name="Product Media" parent="menu_b2b_business_data" action="b2b_core.action_b2b_product_media" sequence="30" groups="b2b_core.group_b2b_marketing_media,b2b_core.group_b2b_product_manager"/>
    <menuitem id="menu_b2b_configuration" name="Configuration" parent="menu_b2b_management_root" sequence="90" groups="b2b_core.group_b2b_manager"/>
    <menuitem id="menu_b2b_segments" name="Customer Segments" parent="menu_b2b_configuration" action="b2b_core.action_b2b_customer_segments" sequence="10"/>
    <menuitem id="menu_b2b_brands" name="Product Brands" parent="menu_b2b_configuration" action="b2b_core.action_b2b_product_brands" sequence="20"/>
    <menuitem id="menu_b2b_applications" name="Product Applications" parent="menu_b2b_configuration" action="b2b_core.action_b2b_product_applications" sequence="30"/>
    <menuitem id="menu_b2b_homepage_products" name="Homepage Featured Products" parent="menu_b2b_configuration" action="b2b_website.action_b2b_homepage_products" sequence="40"/>
    <menuitem id="menu_b2b_faq" name="Frequently Asked Questions" parent="menu_b2b_configuration" action="b2b_website.action_b2b_faq_items" sequence="50"/>
    <menuitem id="menu_b2b_faq_categories" name="FAQ Categories" parent="menu_b2b_configuration" action="b2b_website.action_b2b_faq_categories" sequence="51"/>
    <menuitem id="menu_b2b_settings" name="Settings" parent="menu_b2b_configuration" action="base_setup.action_general_configuration" sequence="90"/>
</odoo>
