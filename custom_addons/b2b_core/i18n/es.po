#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/customer_type.py:0
msgid ""
"Archive customer types instead of deleting types that have base pricelists."
msgstr ""
"Archiva los tipos de cliente con tarifas base en lugar de eliminarlos."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/price_security.py:0
msgid ""
"B2B Special Price Managers can update prices, but not product master data."
msgstr ""
"Los responsables de precios especiales B2B pueden actualizar precios, pero "
"no los datos maestros del producto."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/partner_pricing.py:0
msgid "Company price overrides must be assigned to the commercial account."
msgstr ""
"Las excepciones de precios de empresa deben asignarse a la cuenta comercial."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/partner_pricing.py:0
msgid ""
"Configure a base pricelist for this customer type, website, and currency "
"before adding a company override."
msgstr ""
"Configura una tarifa base para este tipo de cliente, sitio y moneda antes de"
" añadir una excepción de empresa."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/price_security.py:0
msgid ""
"Deactivate the customer-type base mapping before archiving its pricelist."
msgstr ""
"Desactiva la asignación de tarifa base del tipo de cliente antes de archivar"
" la tarifa."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/product_template.py:0
msgid "Default B2B MOQ must be greater than zero."
msgstr "La cantidad mínima B2B predeterminada debe ser mayor que cero."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid "Only a B2B Manager can approve Partner Hub customers."
msgstr "Solo un B2B Manager puede aprobar clientes del portal."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid ""
"Only a B2B Manager can maintain customer type, segments, and ERP customer "
"data."
msgstr ""
"Solo un B2B Manager puede gestionar tipos, segmentos y datos ERP de "
"clientes."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid "Only a B2B Manager can revoke Partner Hub access."
msgstr "Solo un B2B Manager puede revocar el acceso al portal."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid ""
"Only a B2B Manager or B2B Special Price Manager can assign customer "
"pricelists."
msgstr ""
"Solo un B2B Manager o B2B Special Price Manager puede asignar tarifas de "
"clientes."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid ""
"Partner Hub approval must be changed with the Approve or Revoke action."
msgstr "La aprobación del portal debe cambiarse con Aprobar o Revocar."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid ""
"Partner Hub approval, customer type, segments, and ERP customer data must be"
" maintained on the commercial company record."
msgstr ""
"La aprobación, tipo de cliente, segmentos y datos ERP se gestionan en la "
"ficha de la empresa comercial."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/services/product_service.py:0
msgid "Quantity must start at %(minimum)g and increase in steps of %(step)g."
msgstr ""
"La cantidad debe empezar en %(minimum)g y aumentar en pasos de %(step)g."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/price_security.py:0
msgid ""
"Remove this pricelist from customer-type and company pricing before changing"
" its currency."
msgstr ""
"Retira esta tarifa de tipos de cliente y empresas antes de cambiar su "
"moneda."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/customer_type.py:0
msgid "The base pricelist and website must belong to the same company."
msgstr "La tarifa base y el sitio deben pertenecer a la misma empresa."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/partner_pricing.py:0
msgid "The override pricelist and website must belong to the same company."
msgstr ""
"La tarifa de excepción y el sitio deben pertenecer a la misma empresa."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/partner_pricing.py:0
msgid ""
"The selected customer type has no active base pricelist for an existing "
"company override."
msgstr ""
"El tipo de cliente no tiene tarifa base activa para una excepción de empresa"
" existente."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/customer_type.py:0
msgid ""
"This base pricelist is required by active company overrides. Remove or "
"deactivate those overrides first."
msgstr ""
"Esta tarifa base es necesaria para excepciones activas. Elimínalas o "
"desactívalas primero."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/price_security.py:0
msgid "You are not authorized to maintain B2B prices."
msgstr "No tienes autorización para mantener precios B2B."

