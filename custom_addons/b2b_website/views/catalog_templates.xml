<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_catalog" name="Partner Product Catalog">
        <t t-call="b2b_website.partner_layout">
            <section class="lt-page-head"><div class="container"><span class="lt-kicker">PRODUCT CATALOG</span><h1>Solutions for every space</h1><p>Results are tailored to your Partner Hub access.</p></div></section>
            <section class="lt-section"><div class="container lt-catalog-layout">
                <aside class="lt-filter-panel" aria-label="Product filters">
                    <form action="/products" method="get">
                        <div class="lt-field"><label for="lt-search">Search</label><div class="lt-search"><input id="lt-search" name="search" type="search" t-att-value="query.get('search', '')" placeholder="Product, model or keyword"/><button type="submit" aria-label="Search"><i class="fa fa-search"/></button></div></div>
                        <div class="lt-field"><label for="lt-category">Category</label><select id="lt-category" name="category"><option value="">All categories</option><option t-foreach="categories" t-as="item" t-att-value="item.id" t-att-selected="str(item.id) == query.get('category')" t-out="item.name"/></select></div>
                        <div class="lt-field"><label for="lt-brand">Brand</label><select id="lt-brand" name="brand"><option value="">All brands</option><option t-foreach="brands" t-as="item" t-att-value="item.id" t-att-selected="str(item.id) == query.get('brand')" t-out="item.name"/></select></div>
                        <div class="lt-field"><label for="lt-tag">Product tag</label><select id="lt-tag" name="tag"><option value="">All tags</option><option t-foreach="tags" t-as="item" t-att-value="item.id" t-att-selected="str(item.id) == query.get('tag')" t-out="item.name"/></select></div>
                        <div class="lt-field"><label for="lt-application">Application</label><select id="lt-application" name="application"><option value="">All applications</option><option t-foreach="applications" t-as="item" t-att-value="item.id" t-att-selected="str(item.id) == query.get('application')" t-out="item.name"/></select></div>
                        <button class="lt-btn lt-btn--primary lt-btn--wide" type="submit">Apply filters</button><a class="lt-filter-reset" href="/products">Clear all</a>
                    </form>
                </aside>
                <div class="lt-catalog-results">
                    <div class="lt-results-bar"><strong><t t-out="total"/> products</strong><button class="lt-btn lt-btn--small lt-mobile-filter" type="button" data-lt-filter-toggle="">Filters</button></div>
                    <div t-if="products" class="lt-product-grid"><t t-foreach="products" t-as="product"><t t-call="b2b_website.product_card"/></t></div>
                    <div t-else="" class="lt-empty"><div class="lt-empty__icon"><i class="fa fa-search"/></div><h2>No matching products</h2><p>Adjust your filters, or contact us if you expect access to a product family.</p><a class="lt-btn lt-btn--ghost-dark" href="/products">Reset filters</a></div>
                    <t t-if="pager"><t t-call="portal.pager"/></t>
                </div>
            </div></section>
        </t>
    </template>

    <template id="product_detail" name="Partner Product Detail">
        <t t-call="b2b_website.partner_layout">
            <t t-set="additional_title" t-value="product.name"/>
            <section class="lt-section"><div class="container">
                <nav class="lt-breadcrumb" aria-label="Breadcrumb"><a href="/products">Products</a><span>/</span><span t-out="product.name"/></nav>
                <div class="lt-product-detail">
                    <div class="lt-gallery" data-lt-gallery="">
                        <div class="lt-gallery__stage"><img data-lt-gallery-image="" t-att-src="'/web/image/product.template/%s/image_1024' % product.id" t-att-alt="product.name"/><div t-foreach="media.filtered('video_url')" t-as="video" t-att-id="'lt-video-%s' % video.id" class="lt-gallery__video d-none" t-field="video.embed_code"/></div>
                        <div class="lt-gallery__thumbs">
                            <button type="button" class="is-active" t-att-data-image-src="'/web/image/product.template/%s/image_1024' % product.id"><img t-att-src="'/web/image/product.template/%s/image_128' % product.id" t-att-alt="'%s main image' % product.name"/></button>
                            <button t-foreach="media" t-as="item" type="button" t-att-data-image-src="'/web/image/product.image/%s/image_1024' % item.id" t-att-data-video-target="'lt-video-%s' % item.id if item.video_url else ''"><img t-att-src="'/web/image/product.image/%s/image_128' % item.id" t-att-alt="item.name"/><i t-if="item.video_url" class="fa fa-play" aria-hidden="true"/></button>
                        </div>
                    </div>
                    <div class="lt-product-summary">
                        <span class="lt-kicker" t-out="product.b2b_brand_id.name or 'LUCKY TONE'"/><h1 t-out="product.name"/>
                        <dl class="lt-product-meta"><div><dt>Model</dt><dd t-out="product.b2b_model_number or '—'"/></div><div><dt>SKU</dt><dd t-out="variant.default_code or '—'"/></div><div><dt>Category</dt><dd t-out="', '.join(product.public_categ_ids.mapped('name')) or '—'"/></div></dl>
                        <t t-call="b2b_website.price_display"/>
                        <div class="lt-actions lt-actions--stack">
                            <a t-if="not request.env.user._is_public()" class="lt-btn lt-btn--ghost-dark" t-att-href="'/sample/request?product_id=%s' % variant.id">Request sample</a>
                            <a t-else="" class="lt-btn lt-btn--ghost-dark" t-att-href="'/web/login?redirect=/sample/request?product_id=%s' % variant.id">Login to request sample</a>
                            <form t-if="price.get('state') == 'visible'" class="lt-cart-form" data-lt-cart-form="">
                                <input type="hidden" name="product_template_id" t-att-value="product.id"/><input type="hidden" name="product_id" t-att-value="variant.id"/><input type="hidden" name="uom_id" t-att-value="variant.uom_id.id"/><label class="visually-hidden" for="lt-qty">Quantity</label><input id="lt-qty" type="number" name="add_qty" min="1" max="10000" value="1"/><button class="lt-btn lt-btn--primary" type="submit">Add to cart</button><div class="lt-cart-form__status" data-lt-cart-status="" aria-live="polite"/>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="lt-detail-sections">
                    <section><span class="lt-kicker">OVERVIEW</span><h2>Product overview</h2><div class="lt-richtext" t-field="product.description_ecommerce"/></section>
                    <section t-if="product.b2b_specifications"><span class="lt-kicker">SPECIFICATIONS</span><h2>Technical information</h2><div class="lt-richtext lt-specs" t-field="product.b2b_specifications"/></section>
                    <section id="resources"><span class="lt-kicker">RESOURCES</span><h2>Technical documents</h2>
                        <div t-if="resources" class="lt-resource-list"><article t-foreach="resources" t-as="resource" class="lt-resource-card"><div class="lt-resource-card__icon"><i class="fa fa-file-o"/></div><div><span class="lt-eyebrow" t-out="dict(resource._fields['b2b_resource_type'].selection).get(resource.b2b_resource_type)"/><h3 t-out="resource.name"/><p><span t-if="resource.b2b_version">Version <t t-out="resource.b2b_version"/> · </span><span t-if="resource.b2b_language"><t t-out="resource.b2b_language"/> · </span><span t-out="(resource.mimetype or 'File').split('/')[-1].upper()"/><span t-if="resource.file_size"> · <t t-out="'%.1f MB' % (resource.file_size / 1048576.0)"/></span></p></div><a class="lt-btn lt-btn--small" t-att-href="'/products/resource/%s' % resource.id">Download</a></article></div>
                        <div t-else="" class="lt-empty lt-empty--compact"><p>No resources are available for your access level.</p></div>
                    </section>
                    <section t-if="related"><span class="lt-kicker">RELATED PRODUCTS</span><h2>Complete the solution</h2><t t-set="products" t-value="related"/><t t-set="prices" t-value="related_prices"/><div class="lt-product-grid"><t t-foreach="products" t-as="product"><t t-call="b2b_website.product_card"/></t></div></section>
                </div>
            </div></section>
        </t>
    </template>
</odoo>
