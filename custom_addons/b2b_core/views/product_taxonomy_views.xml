<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_b2b_product_brand_list" model="ir.ui.view">
        <field name="name">b2b.product.brand.list</field>
        <field name="model">b2b.product.brand</field>
        <field name="arch" type="xml">
            <list editable="bottom" open_form_view="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="tagline" optional="show"/>
                <field name="product_count"/>
                <field name="website_published" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_b2b_product_brand_form" model="ir.ui.view">
        <field name="name">b2b.product.brand.form</field>
        <field name="model">b2b.product.brand</field>
        <field name="arch" type="xml">
            <form><sheet><widget name="web_ribbon" title="Not Published" bg_color="text-bg-danger" invisible="website_published"/><group><group><field name="name"/><field name="tagline"/><field name="sequence"/><field name="active"/><field name="website_published"/></group><group><field name="logo" widget="image" class="oe_avatar"/><field name="cover_image" widget="image"/></group></group><notebook><page string="Website Content"><field name="website_description" widget="html"/><group><field name="product_focus" placeholder="One item per line"/><field name="advantages" placeholder="One item per line"/></group></page><page string="Internal Notes"><field name="description"/></page></notebook></sheet></form>
        </field>
    </record>
    <record id="action_b2b_product_brands" model="ir.actions.act_window">
        <field name="name">Product Brands</field>
        <field name="res_model">b2b.product.brand</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_b2b_product_application_list" model="ir.ui.view">
        <field name="name">b2b.product.application.list</field>
        <field name="model">b2b.product.application</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_b2b_product_application_form" model="ir.ui.view">
        <field name="name">b2b.product.application.form</field>
        <field name="model">b2b.product.application</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="name"/><field name="sequence"/><field name="active"/></group><field name="description"/></sheet></form>
        </field>
    </record>
    <record id="action_b2b_product_applications" model="ir.actions.act_window">
        <field name="name">Product Applications</field>
        <field name="res_model">b2b.product.application</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
