<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_b2b_order_change_list" model="ir.ui.view">
        <field name="name">b2b.order.change.request.list</field>
        <field name="model">b2b.order.change.request</field>
        <field name="arch" type="xml">
            <list decoration-warning="state in ('submitted', 'balance_due', 'finance_review')" decoration-success="state == 'completed'" decoration-muted="state in ('rejected', 'cancelled')">
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="state" widget="badge"/>
                <field name="original_amount"/>
                <field name="proposed_amount"/>
                <field name="delta_amount"/>
                <field name="assigned_user_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_b2b_order_change_form" model="ir.ui.view">
        <field name="name">b2b.order.change.request.form</field>
        <field name="model">b2b.order.change.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_review" type="object" string="Start Review" class="btn-primary" invisible="state != 'submitted'" groups="b2b_core.group_b2b_manager"/>
                    <button name="action_open_revision" type="object" string="Edit Proposed Order" class="btn-primary" invisible="not revision_order_id or state != 'under_review'" groups="b2b_core.group_b2b_manager"/>
                    <button name="action_send_proposal" type="object" string="Send to Customer" class="btn-primary" invisible="state != 'under_review'" groups="b2b_core.group_b2b_manager"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state not in ('submitted', 'under_review', 'customer_confirmation')" groups="b2b_core.group_b2b_manager"/>
                    <button name="action_finance_complete" type="object" string="Finance Complete" class="btn-primary" invisible="state != 'finance_review'" groups="account.group_account_invoice"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,under_review,customer_confirmation,balance_due,finance_review,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_revision" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not revision_order_id or state != 'under_review'" groups="b2b_core.group_b2b_manager">
                            <div class="o_stat_info"><span class="o_stat_text">Proposed Revision</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" text="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" text="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="order_id" readonly="state != 'submitted'"/>
                            <field name="partner_id"/>
                            <field name="assigned_user_id"/>
                            <field name="revision_number"/>
                        </group>
                        <group>
                            <field name="original_amount"/>
                            <field name="proposed_amount"/>
                            <field name="delta_amount"/>
                            <field name="has_posted_invoice"/>
                            <field name="has_delivered_items"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Customer Request">
                            <group><field name="requested_changes"/><field name="customer_note"/></group>
                        </page>
                        <page string="Finance" invisible="state not in ('finance_review', 'completed')">
                            <group>
                                <field name="adjustment_move_id"/>
                                <field name="refund_transaction_id" invisible="delta_amount &gt;= 0" domain="[('operation', '=', 'refund'), ('state', '=', 'done'), ('source_transaction_id.sale_order_ids', 'in', [order_id])]" options="{'no_create': True}"/>
                                <field name="finance_reference" required="state == 'finance_review'"/>
                                <field name="finance_note"/>
                            </group>
                        </page>
                        <page string="Decision" invisible="state not in ('submitted', 'under_review', 'customer_confirmation', 'rejected', 'cancelled')">
                            <field name="rejection_reason" required="state == 'rejected'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_b2b_order_change_search" model="ir.ui.view">
        <field name="name">b2b.order.change.request.search</field>
        <field name="model">b2b.order.change.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="order_id"/><field name="partner_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('submitted', 'under_review', 'customer_confirmation', 'balance_due', 'finance_review', 'applying'))]"/>
                <filter name="refunds" string="Refund Review" domain="[('state', '=', 'finance_review'), ('delta_amount', '&lt;', 0)]"/>
                <group><filter name="group_state" string="State" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>

    <record id="action_b2b_order_changes" model="ir.actions.act_window">
        <field name="name">Order Changes</field>
        <field name="res_model">b2b.order.change.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_b2b_order_change_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
