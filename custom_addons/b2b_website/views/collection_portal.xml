<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="collection_invoice_due_terms" inherit_id="sale.sale_order_portal_content" priority="100">
        <xpath expr="//section[@t-if='sale_order.payment_term_id']/h4" position="replace">
            <h4><t t-if="sale_order.b2b_collection_active">Invoice Due Terms</t><t t-else="">Payment terms</t></h4>
        </xpath>
        <xpath expr="//section[@t-if='sale_order.payment_term_id']/span" position="before">
            <p t-if="sale_order.b2b_collection_active">These terms determine invoice due dates only. Production and shipment follow the Collection Terms shown above. Confirmed payments are credited separately; this is not an additional payment request.</p>
        </xpath>
    </template>
    <template id="collection_order_terms" inherit_id="sale.sale_order_portal_template" priority="100"><xpath expr="//div[@id='sale_order_sidebar_button']" position="before"><div t-if="sale_order.b2b_collection_active" class="alert alert-info mt-3"><strong>Collection Terms</strong><br/><span t-out="sale_order.b2b_collection_policy_id.name"/><br/>Production requires <t t-out="sale_order.b2b_production_percent"/>%; shipment requires <t t-out="sale_order.b2b_shipment_percent"/>%. Invoice due dates are shown separately on issued invoices.</div></xpath></template>
    <template id="collection_order_link" inherit_id="sale.sale_order_portal_template" priority="99"><xpath expr="//div[@id='sale_order_sidebar_button']" position="inside"><a t-if="sale_order.website_id and not sale_order.b2b_is_change_revision" class="btn btn-outline-primary" t-att-href="'/my/orders/%s/collection' % sale_order.id">Payments, Bank Transfer &amp; PI</a></xpath></template>
    <template id="collection_checkout" inherit_id="website_sale.payment" priority="99"><xpath expr="//div[@id='address_on_payment']" position="before"><section class="card mb-4"><div class="card-body"><h4>Bank Transfer / Customer Payment Terms</h4><p>Submit this order to download your PI, view the receiving bank account and upload payment evidence. Production and shipment follow your approved company terms.</p><form action="/shop/b2b-submit-order" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-primary" type="submit" data-lt-stable-submit="">Submit Order — Pay by Bank / Agreed Terms</button></form></div></section></xpath></template>
    <template id="portal_collection" name="Order Collections">
        <t t-call="portal.portal_layout"><t t-set="no_index" t-value="True"/>
            <nav class="lt-portal-breadcrumb"><a href="/my/orders">Orders</a><span>/</span><a t-att-href="order.get_portal_url()" t-out="order.name"/><span>/</span>Payments &amp; PI</nav>
            <header class="lt-portal-heading"><h1>Payments &amp; PI</h1><p>View confirmed receipts, payment evidence and bank instructions for <t t-out="order.name"/>.</p></header>
            <div t-if="error" class="alert alert-warning" role="alert" t-out="error"/>
            <div t-if="submitted" class="alert alert-success" role="status">Your payment evidence was submitted. It does not count as received funds until Finance verifies the bank receipt.</div>
            <div class="lt-detail-grid"><section class="lt-portal-card"><header><h2>Payment Summary</h2></header><div class="lt-card-body">
                <dl class="row"><dt class="col-7">Collection Terms</dt><dd class="col-5"><t t-out="order.b2b_collection_policy_id.name or 'Pending configuration'"/></dd><dt class="col-7">Order Total</dt><dd class="col-5"><span t-field="order.amount_total"/></dd><dt class="col-7">Confirmed Payments</dt><dd class="col-5"><span t-field="order.b2b_net_received"/></dd><dt class="col-7">Evidence Awaiting Review</dt><dd class="col-5"><span t-field="order.b2b_pending_proof"/></dd><dt class="col-7">Remaining Balance</dt><dd class="col-5"><span t-field="order.b2b_balance"/></dd><dt class="col-7">Required for Current Stage</dt><dd class="col-5"><span t-field="order.b2b_payable_now"/></dd></dl>
                <p>Production: <strong t-out="'Released' if order.state == 'sale' and order.b2b_production_allowed else 'Awaiting release'"/></p><p>Shipment: <strong t-out="'Allowed' if order.b2b_shipment_allowed else 'On hold / not ready'"/></p>
                <p t-if="order.b2b_shipment_percent &lt; 100">Credit balance follows the due dates on your issued invoices. A remaining balance does not necessarily mean overdue payment.</p>
                <a t-if="order.b2b_balance &gt; 0 and order.b2b_review_state != 'pending' and order.state != 'cancel'" class="lt-btn lt-btn--blue" t-att-href="order.get_portal_url(query_string='&amp;payment_amount=%s' % (order.b2b_payable_now or order.b2b_balance))">Pay Online</a>
            </div></section><section class="lt-portal-card"><header><h2>Bank Transfer Instructions</h2></header><div class="lt-card-body"><p t-if="order.b2b_bank_instructions" class="lt-preserve-lines" t-out="order.b2b_bank_instructions"/><p t-else="">Our team must configure your receiving account. Please contact us before transferring funds.</p><a t-if="order.b2b_bank_instructions and order.b2b_review_state != 'pending'" class="lt-btn lt-btn--outline" t-att-href="'/my/orders/%s/collection/pi' % order.id">Download Current PI</a><a t-else="" class="lt-btn lt-btn--outline" href="/contact">Contact us</a></div></section></div>
            <section t-if="order.b2b_collection_active and order.b2b_balance &gt; 0 and order.b2b_receiving_journal_id and order.b2b_review_state != 'pending' and order.state != 'cancel'" class="lt-portal-card mt-4"><header><h2>Upload Payment Proof</h2></header><div class="lt-card-body"><form t-att-action="'/my/orders/%s/collection/proof' % order.id" method="post" enctype="multipart/form-data" data-lt-submit-once=""><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="submission_key" t-att-value="submission_key"/><div class="row g-3"><div class="col-md-4"><label class="form-label" for="transfer_amount">Transfer Amount (<t t-out="order.currency_id.name"/>)</label><input id="transfer_amount" class="form-control" name="amount" type="number" step="any" min="0.01" required="required"/></div><div class="col-md-4"><label class="form-label" for="transfer_date">Transfer Date</label><input id="transfer_date" class="form-control" name="transfer_date" type="date" required="required"/></div><div class="col-md-4"><label class="form-label" for="transfer_ref">Bank Reference</label><input id="transfer_ref" class="form-control" name="reference" maxlength="160" required="required"/></div><div class="col-12"><label class="form-label" for="transfer_proof">Proof (PDF, PNG or JPG, up to 8 MB)</label><input id="transfer_proof" class="form-control" name="proof" type="file" accept="application/pdf,image/png,image/jpeg" required="required"/></div><div class="col-12"><label class="form-label" for="transfer_note">Additional Information</label><textarea id="transfer_note" class="form-control" name="note" maxlength="2000"/></div></div><button class="lt-btn lt-btn--blue mt-3" type="submit" data-lt-stable-submit="">Submit Payment Proof</button></form></div></section>
            <section class="lt-portal-card mt-4"><header><h2>Bank Transfer History</h2></header><div class="table-responsive"><table class="lt-data-table"><thead><tr><th>Reference</th><th>Declared</th><th>Confirmed</th><th>Status / Finance Note</th><th>Evidence</th></tr></thead><tbody><tr t-foreach="receipts" t-as="receipt"><td t-out="receipt.name"/><td><span t-field="receipt.declared_amount"/></td><td><span t-field="receipt.order_amount"/></td><td><t t-out="dict(receipt._fields['state'].selection).get(receipt.state)"/><p t-if="receipt.review_note" t-out="receipt.review_note"/></td><td><a t-foreach="receipt.attachment_ids" t-as="attachment" t-att-href="'/my/orders/%s/collection/proof/%s/%s' % (order.id, receipt.id, attachment.id)">Download</a></td></tr></tbody></table></div><div t-if="not receipts" class="lt-card-body">No payment evidence submitted yet.</div></section>
            <section t-if="pis" class="lt-portal-card mt-4"><header><h2>Issued PI Versions</h2></header><div class="lt-card-body"><p t-foreach="pis" t-as="pi"><a t-att-href="'/my/orders/%s/collection/pi?version=%s' % (order.id, pi.id)">Download PI v<t t-out="pi.revision"/></a> · <span t-field="pi.create_date"/></p></div></section>
        </t>
    </template>
</odoo>
