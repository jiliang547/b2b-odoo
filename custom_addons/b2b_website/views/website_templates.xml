<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="partner_layout" name="Partner Hub Layout">
        <t t-call="website.layout">
            <t t-set="additional_title">Lucky Tone Partner Hub</t>
            <t t-set="meta_description">Professional audio solutions, partner pricing and service from Lucky Tone.</t>
            <div class="lt-hub">
                <nav class="lt-subnav" aria-label="Partner Hub navigation">
                    <div class="container lt-subnav__inner">
                        <a class="lt-brand" href="/" aria-label="Lucky Tone home">
                            <span class="lt-brand__mark" aria-hidden="true"><i/></span>
                            <strong>LUCKY TONE</strong>
                        </a>
                        <button class="lt-nav-toggle" type="button" aria-expanded="false" aria-controls="lt-partner-navigation">
                            <span class="visually-hidden">Toggle navigation</span><i class="fa fa-bars" aria-hidden="true"/>
                        </button>
                        <div id="lt-partner-navigation" class="lt-nav-shell">
                            <div class="lt-nav-links">
                                <a t-att-class="'is-active' if request.httprequest.path.startswith('/products') else ''" href="/products">Products</a>
                                <a t-att-class="'is-active' if request.httprequest.path.startswith('/resources') else ''" href="/resources">Resources</a>
                                <a t-if="not request.env.user._is_public()" t-att-class="'is-active' if request.httprequest.path.startswith('/sample') else ''" href="/samples">Samples</a>
                                <a t-if="not request.env.user._is_public()" t-att-class="'is-active' if request.httprequest.path.startswith('/service') else ''" href="/service-center">Service</a>
                                <a t-att-class="'is-active' if request.httprequest.path == '/about' else ''" href="/about">About</a>
                                <a href="/contactus">Contact</a>
                            </div>
                            <div class="lt-nav-actions">
                                <a t-if="request.env.user._is_public()" class="lt-btn lt-btn--light lt-btn--nav" href="/web/login?redirect=/my">Sign in</a>
                                <a t-if="request.env.user._is_public()" class="lt-btn lt-btn--lime lt-btn--nav" href="/partner-application">Partner application</a>
                                <a t-if="not request.env.user._is_public()" class="lt-btn lt-btn--light lt-btn--nav" href="/my">My Account</a>
                                <a class="lt-btn lt-btn--lime lt-btn--nav lt-cart-link" href="/shop/cart">Cart <span t-if="request.session.get('website_sale_cart_quantity')" t-out="request.session.get('website_sale_cart_quantity')"/></a>
                            </div>
                        </div>
                    </div>
                </nav>
                <main id="main" tabindex="-1"><t t-out="0"/></main>
                <footer class="lt-footer">
                    <div class="container lt-footer__inner">
                        <div><div class="lt-footer__brand">LUCKY TONE</div><p>Professional audio · B2B supply · Partner service</p></div>
                        <div class="lt-footer__links"><a href="/products">Products</a><a href="/resources">Resources</a><a href="/my">Partner</a><a href="/about">Company</a><a href="/privacy">Privacy</a></div>
                    </div>
                </footer>
            </div>
        </t>
    </template>

    <template id="price_display" name="Partner Price Display">
        <t t-set="price" t-value="price or {}"/>
        <div t-att-class="'lt-price lt-price--%s' % (price.get('state') or 'contact')">
            <t t-if="price.get('state') == 'visible'"><span class="lt-price__label">Partner price</span><strong t-out="price.get('price')" t-options="{'widget': 'monetary', 'display_currency': price.get('currency')}"/></t>
            <t t-elif="price.get('state') == 'login'"><span>Sign in to view partner pricing</span><a href="/web/login?redirect=/products">Sign in</a></t>
            <t t-elif="price.get('state') == 'quote'"><span>Partner price by quotation</span><a href="/contactus">Request quote</a></t>
            <t t-else=""><span>Contact us for pricing</span><a href="/contactus">Contact sales</a></t>
        </div>
    </template>

    <template id="product_card" name="Partner Product Card">
        <t t-set="price" t-value="prices.get(product.id) if prices else {}"/><t t-set="variant" t-value="product.product_variant_id"/>
        <article class="lt-product-card">
            <a class="lt-product-card__image" t-att-href="'/products/%s' % request.env['ir.http']._slug(product)">
                <span class="lt-product-card__sku" t-out="product.b2b_model_number or variant.default_code or 'LUCKY TONE'"/>
                <img t-att-src="'/web/image/product.template/%s/image_512' % product.id" t-att-alt="product.name" loading="lazy"/>
            </a>
            <div class="lt-product-card__body">
                <h3><a t-att-href="'/products/%s' % request.env['ir.http']._slug(product)" t-out="product.name"/></h3>
                <p class="lt-product-card__model"><span t-out="product.b2b_model_number or variant.default_code or 'Model on request'"/><t t-if="product.public_categ_ids"> · <span t-out="product.public_categ_ids[:1].name"/></t></p>
                <div class="lt-product-card__commerce"><t t-call="b2b_website.price_display"/><span t-if="price.get('state') == 'visible'" class="lt-status-badge lt-status-badge--available">Available</span></div>
                <p class="lt-product-card__description" t-out="product.description_sale or ''"/>
                <div class="lt-product-card__actions">
                    <a class="lt-btn lt-btn--outline lt-btn--small" t-att-href="'/products/%s' % request.env['ir.http']._slug(product)">Details</a>
                    <a class="lt-compare-link" t-att-href="'/products/compare?ids=%s' % product.id">Compare</a>
                    <form t-if="price.get('state') == 'visible' and variant" class="lt-card-cart" data-lt-cart-form="">
                        <input type="hidden" name="product_template_id" t-att-value="product.id"/><input type="hidden" name="product_id" t-att-value="variant.id"/><input type="hidden" name="uom_id" t-att-value="variant.uom_id.id"/><input type="hidden" name="add_qty" value="1"/>
                        <button class="lt-btn lt-btn--blue lt-btn--small" type="submit">Add</button><span class="lt-cart-form__status" data-lt-cart-status="" aria-live="polite"/>
                    </form>
                </div>
            </div>
        </article>
    </template>

    <template id="partner_hub_homepage" name="Partner Hub Homepage">
        <t t-call="b2b_website.partner_layout">
            <section class="lt-hero"><div class="container lt-hero__grid">
                <div class="lt-hero__copy">
                    <span class="lt-pill lt-pill--light">B2B AUDIO SUPPLY NETWORK</span>
                    <h1>Procure professional audio with less friction.</h1>
                    <p>Partner pricing, samples, technical resources, service and ERP-visible order progress in one enterprise portal.</p>
                    <div class="lt-actions"><a class="lt-btn lt-btn--lime" href="/products">Browse products</a><a t-if="not request.env.user._is_public()" class="lt-btn lt-btn--light" href="/sample/request">Request samples</a><a t-else="" class="lt-btn lt-btn--light" href="/web/login?redirect=/sample/request">Request samples</a></div>
                </div>
                <div class="lt-hero__visual"><img src="/b2b_website/static/src/img/partner-hub-industrial.svg" alt="Professional audio rack equipment"/></div>
            </div></section>
            <section class="lt-home-content"><div class="container">
                <div class="lt-metrics" aria-label="Partner Hub highlights">
                    <article><span class="lt-pill lt-pill--blue">Products</span><strong t-out="catalog_total"/><small>Partner-ready catalog</small></article>
                    <article><span class="lt-pill lt-pill--green">Categories</span><strong t-out="len(categories)"/><small>Professional audio families</small></article>
                    <article><span class="lt-pill lt-pill--slate">Experience</span><strong>18 yrs</strong><small>Industry expertise</small></article>
                    <article><span class="lt-pill lt-pill--amber">Response</span><strong>&lt;4h</strong><small>Partner support target</small></article>
                </div>
                <div class="lt-section-heading lt-section-heading--stacked"><span class="lt-kicker">EXPLORE</span><h2>Product categories</h2></div>
                <div t-if="categories" class="lt-category-grid"><a t-foreach="categories[:4]" t-as="category" t-att-href="'/products?category=%s' % category.id"><span class="lt-pill lt-pill--blue" t-out="category.name"/><p>Browse partner-ready products</p></a></div>
                <div t-else="" class="lt-empty lt-empty--compact"><p>Product categories will appear here when products are published.</p></div>
                <div class="lt-section-heading lt-section-heading--stacked lt-featured-heading"><span class="lt-kicker">FEATURED</span><h2>Popular partner products</h2></div>
                <div t-if="products" class="lt-product-grid lt-product-grid--featured"><t t-foreach="products[:4]" t-as="product"><t t-call="b2b_website.product_card"/></t></div>
                <div t-else="" class="lt-empty"><h3>No products are available yet</h3><p>Published products that match your access will appear here.</p></div>
            </div></section>
        </t>
    </template>
</odoo>
