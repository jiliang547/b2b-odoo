#: code:addons/b2b_core/models/customer_type.py:0
msgid ""
"Archive customer types instead of deleting types that have base pricelists."
msgstr ""
"Archivez les types de clients ayant des tarifs de base au lieu de les "
"supprimer."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/price_security.py:0
msgid ""
"B2B Special Price Managers can update prices, but not product master data."
msgstr ""
"Les responsables des prix spéciaux B2B peuvent modifier les prix, mais pas "
"les données de référence des produits."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/partner_pricing.py:0
msgid "Company price overrides must be assigned to the commercial account."
msgstr ""
"Les dérogations tarifaires doivent être affectées au compte commercial."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/partner_pricing.py:0
msgid ""
"Configure a base pricelist for this customer type, website, and currency "
"before adding a company override."
msgstr ""
"Configurez un tarif de base pour ce type de client, ce site et cette devise "
"avant d’ajouter une dérogation d’entreprise."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/price_security.py:0
msgid ""
"Deactivate the customer-type base mapping before archiving its pricelist."
msgstr ""
"Désactivez l’association du tarif de base au type de client avant d’archiver"
" le tarif."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/product_template.py:0
msgid "Default B2B MOQ must be greater than zero."
msgstr "La quantité minimale B2B par défaut doit être supérieure à zéro."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid "Only a B2B Manager can approve Partner Hub customers."
msgstr "Seul un B2B Manager peut approuver les clients partenaires."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid ""
"Only a B2B Manager can maintain customer type, segments, and ERP customer "
"data."
msgstr ""
"Seul un B2B Manager peut gérer types, segments et données ERP clients."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid "Only a B2B Manager can revoke Partner Hub access."
msgstr "Seul un B2B Manager peut révoquer l’accès au portail."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid ""
"Only a B2B Manager or B2B Special Price Manager can assign customer "
"pricelists."
msgstr ""
"Seul un B2B Manager ou B2B Special Price Manager peut affecter des tarifs "
"clients."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid ""
"Partner Hub approval must be changed with the Approve or Revoke action."
msgstr ""
"L’approbation du portail doit être modifiée via Approuver ou Révoquer."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid ""
"Partner Hub approval, customer type, segments, and ERP customer data must be"
" maintained on the commercial company record."
msgstr ""
"L’approbation, le type de client, les segments et données ERP doivent être "
"gérés sur la fiche de l’entreprise commerciale."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/services/product_service.py:0
msgid "Quantity must start at %(minimum)g and increase in steps of %(step)g."
msgstr ""
"La quantité doit commencer à %(minimum)g et augmenter par pas de %(step)g."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/price_security.py:0
msgid ""
"Remove this pricelist from customer-type and company pricing before changing"
" its currency."
msgstr ""
"Retirez ce tarif des types de clients et entreprises avant de changer sa "
"devise."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/customer_type.py:0
msgid "The base pricelist and website must belong to the same company."
msgstr "Le tarif de base et le site doivent appartenir à la même entreprise."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/partner_pricing.py:0
msgid "The override pricelist and website must belong to the same company."
msgstr ""
"Le tarif dérogatoire et le site doivent appartenir à la même entreprise."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/partner_pricing.py:0
msgid ""
"The selected customer type has no active base pricelist for an existing "
"company override."
msgstr ""
"Le type de client n’a pas de tarif de base actif pour une dérogation "
"d’entreprise existante."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/customer_type.py:0
msgid ""
"This base pricelist is required by active company overrides. Remove or "
"deactivate those overrides first."
msgstr ""
"Ce tarif de base est requis par des dérogations actives. Supprimez-les ou "
"désactivez-les d’abord."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/price_security.py:0
msgid "You are not authorized to maintain B2B prices."
msgstr "Vous n’êtes pas autorisé à gérer les prix B2B."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/partner_pricing.py:0
msgid "[B2B Effective] %(customer)s / %(currency)s"
msgstr "[B2B Effectif] %(customer)s / %(currency)s"

