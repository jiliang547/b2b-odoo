<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_catalog" name="Partner Product Catalog">
        <t t-call="b2b_website.partner_layout">
            <section class="lt-catalog-page"><div class="container">
                <nav class="lt-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Products</span></nav>
                <div class="lt-catalog-intro"><h1>Product Catalog</h1><p><t t-out="total"/> industrial products with certified specifications and account-specific pricing.</p></div>
                <form class="lt-catalog-toolbar" action="/products" method="get">
                    <div class="lt-search"><label class="visually-hidden" for="lt-toolbar-search">Search products</label><input id="lt-toolbar-search" name="search" type="search" t-att-value="query.get('search', '')" placeholder="Search SKU, model or keyword"/><button type="submit" aria-label="Search"><i class="fa fa-search"/></button></div>
                    <button class="lt-btn lt-btn--outline lt-mobile-filter" type="button" data-lt-filter-toggle="">Filters <span t-if="active_filter_count" t-out="active_filter_count"/></button>
                    <div class="lt-catalog-toolbar__right"><span class="lt-results-summary"><strong t-out="total"/> products</span><label class="visually-hidden" for="lt-sort">Sort products</label><select id="lt-sort" name="sort" data-lt-auto-submit=""><option value="featured" t-att-selected="sort == 'featured'">Featured</option><option value="newest" t-att-selected="sort == 'newest'">Newest</option><option value="name" t-att-selected="sort == 'name'">Name A–Z</option><option value="name_desc" t-att-selected="sort == 'name_desc'">Name Z–A</option></select><div class="lt-view-switch" role="group" aria-label="Product view"><button type="button" class="is-active" data-lt-view="grid" aria-label="Grid view"><i class="fa fa-th-large"/></button><button type="button" data-lt-view="list" aria-label="List view"><i class="fa fa-list"/></button></div></div>
                </form>
                <div class="lt-catalog-layout">
                    <aside class="lt-filter-panel" aria-label="Product filters">
                        <form action="/products" method="get">
                            <h2>Filter products</h2>
                            <input t-if="sort and sort != 'featured'" type="hidden" name="sort" t-att-value="sort"/>
                            <input t-if="query.get('search')" type="hidden" name="search" t-att-value="query.get('search')"/>
                            <div class="lt-field"><label for="lt-category">Product category</label><select id="lt-category" name="category"><option value="">All categories</option><option t-foreach="categories" t-as="item" t-att-value="item.id" t-att-selected="str(item.id) == query.get('category')" t-out="item.name"/></select></div>
                            <div class="lt-field"><label for="lt-brand">Brand</label><select id="lt-brand" name="brand"><option value="">All brands</option><option t-foreach="brands" t-as="item" t-att-value="item.id" t-att-selected="str(item.id) == query.get('brand')" t-out="item.name"/></select></div>
                            <div class="lt-field"><label for="lt-application">Application</label><select id="lt-application" name="application"><option value="">All applications</option><option t-foreach="applications" t-as="item" t-att-value="item.id" t-att-selected="str(item.id) == query.get('application')" t-out="item.name"/></select></div>
                            <div class="lt-field"><label for="lt-tag">Product tag</label><select id="lt-tag" name="tag"><option value="">All tags</option><option t-foreach="tags" t-as="item" t-att-value="item.id" t-att-selected="str(item.id) == query.get('tag')" t-out="item.name"/></select></div>
                            <button class="lt-btn lt-btn--blue lt-btn--wide" type="submit">Apply filters</button><a class="lt-filter-reset" href="/products">Clear all</a>
                        </form>
                    </aside>
                    <div class="lt-catalog-results">
                        <p class="lt-results-bar"><strong><t t-out="total"/> products</strong><span t-if="price_state == 'visible'">Partner pricing active</span><span t-elif="price_state == 'login'">Sign in for partner pricing</span><span t-elif="price_state == 'quote'">Request a quote for pricing</span><span t-else="">Contact sales for pricing</span></p>
                        <div t-if="products" class="lt-product-grid" data-lt-product-grid=""><t t-foreach="products" t-as="product"><t t-call="b2b_website.product_card"/></t></div>
                        <div t-else="" class="lt-empty"><div class="lt-empty__icon"><i class="fa fa-search"/></div><h2>No matching products</h2><p>Adjust your filters, or contact us if you expect access to a product family.</p><a class="lt-btn lt-btn--outline" href="/products">Reset filters</a></div>
                        <div t-if="pager" class="lt-product-pagination" aria-label="Product pages"><t t-call="portal.pager"><t t-set="classname" t-value="'lt-product-pagination__list'"/></t></div>
                    </div>
                </div>
            </div></section>
        </t>
    </template>

    <template id="product_detail" name="Partner Product Detail">
        <t t-call="b2b_website.partner_layout">
            <t t-set="additional_title" t-value="product.name"/>
            <section class="lt-detail-page"><div class="container">
                <nav class="lt-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/products">Products</a><span>/</span><span t-if="product.public_categ_ids" t-out="product.public_categ_ids[:1].name"/><span t-if="product.public_categ_ids">/</span><span t-out="product.b2b_model_number or product.name"/></nav>
                <div class="lt-product-detail">
                    <div class="lt-gallery" data-lt-gallery="">
                        <div class="lt-gallery__stage"><span class="lt-gallery__sku" data-lt-variant-sku="" t-out="variant.default_code or product.b2b_model_number or 'LUCKY TONE'"/><img data-lt-gallery-image="" t-att-src="'/web/image/product.template/%s/image_1024' % product.id" t-att-alt="product.name"/><div t-foreach="media.filtered('video_url')" t-as="video" t-att-id="'lt-video-%s' % video.id" class="lt-gallery__video d-none" t-field="video.embed_code"/></div>
                        <div class="lt-gallery__thumbs">
                            <button type="button" class="is-active" t-att-data-image-src="'/web/image/product.template/%s/image_1024' % product.id"><img t-att-src="'/web/image/product.template/%s/image_128' % product.id" t-att-alt="'%s main image' % product.name"/></button>
                            <button t-foreach="media" t-as="item" type="button" t-att-class="'is-video' if item.video_url else ''" t-att-data-image-src="'/web/image/product.image/%s/image_1024' % item.id" t-att-data-video-target="'lt-video-%s' % item.id if item.video_url else ''"><img t-att-src="'/web/image/product.image/%s/image_128' % item.id" t-att-alt="item.name"/><span t-if="item.video_url">VIDEO</span></button>
                        </div>
                        <div t-if="product.product_tag_ids" class="lt-product-badges" aria-label="Product attributes"><span t-foreach="product.product_tag_ids[:4]" t-as="tag" t-out="tag.name"/></div>
                    </div>
                    <aside class="lt-purchase-panel">
                        <h1 t-out="product.name"/>
                        <div class="lt-purchase-panel__meta"><p class="lt-purchase-panel__model">SKU: <span data-lt-variant-sku="" t-out="variant.default_code or product.b2b_model_number or 'Model on request'"/></p></div>
                        <p class="lt-purchase-panel__description" t-out="product.description_sale or 'Contact our sales team for application guidance and technical support.'"/>
                        <t t-call="b2b_website.price_display"/>
                        <dl class="lt-procurement-facts"><div><dt>MOQ</dt><dd><strong data-lt-minimum-quantity="" t-out="'%g' % procurement['minimum_quantity']"/> <span data-lt-procurement-uom="" t-out="procurement['uom_name']"/></dd></div><div><dt>Lead time</dt><dd data-lt-lead-time=""><t t-if="procurement['lead_time_days'] is None">Contact sales</t><t t-elif="procurement['lead_time_days']"><strong t-out="procurement['lead_time_days']"/> days</t><t t-else="">Ready to ship</t></dd></div></dl>
                        <div t-if="product.valid_product_template_attribute_line_ids" class="lt-variant-picker" data-lt-variant-picker="" t-att-data-template-id="product.id" t-att-data-product-id="variant.id">
                            <div t-foreach="product.valid_product_template_attribute_line_ids" t-as="line" class="lt-field"><label t-att-for="'lt-attribute-%s' % line.id" t-out="line.attribute_id.name"/><select t-att-id="'lt-attribute-%s' % line.id" data-lt-variant-attribute=""><option t-foreach="line.product_template_value_ids._only_active()" t-as="value" t-att-value="value.id" t-att-selected="value in variant.product_template_attribute_value_ids" t-out="value.name"/></select></div>
                        </div>
                        <form t-if="price.get('state') == 'visible'" class="lt-cart-form" data-lt-cart-form="">
                            <input type="hidden" name="product_template_id" t-att-value="product.id"/><input type="hidden" name="product_id" t-att-value="variant.id"/><input type="hidden" name="uom_id" t-att-value="variant.uom_id.id"/>
                            <div class="lt-quantity-heading"><label for="lt-qty">Quantity</label><span>Min. <strong data-lt-minimum-hint="" t-out="'%g' % procurement['minimum_quantity']"/> <span data-lt-minimum-uom="" t-out="procurement['uom_name']"/></span></div>
                            <div class="lt-quantity-row"><div class="lt-quantity-control" data-lt-quantity-control=""><button type="button" data-lt-quantity-decrease="" aria-label="Decrease quantity">−</button><input id="lt-qty" type="number" name="add_qty" t-att-min="'%g' % procurement['minimum_quantity']" max="10000" t-att-step="'%g' % procurement['quantity_step']" t-att-value="'%g' % procurement['minimum_quantity']"/><button type="button" data-lt-quantity-increase="" aria-label="Increase quantity">+</button></div><div class="lt-cart-form__status lt-cart-form__status--quantity" data-lt-cart-status="" aria-live="polite"/></div>
                            <div class="lt-purchase-actions"><button class="lt-btn lt-btn--blue lt-btn--wide" type="submit"><i class="fa fa-shopping-cart"/> Add to Cart</button></div>
                        </form>
                        <div class="lt-secondary-purchase-actions"><a t-if="request.env.user._is_public()" class="lt-btn lt-btn--outline" data-lt-sample-link="" t-att-href="'/web/login?redirect=/sample/request?product_id=%s' % variant.id">Sign in for Sample</a><a t-elif="sample_allowed" class="lt-btn lt-btn--outline" data-lt-sample-link="" t-att-href="'/sample/request?product_id=%s' % variant.id">Request Sample</a><a t-else="" class="lt-btn lt-btn--outline" data-lt-sample-link="" t-att-href="'/sample/request?product_id=%s' % variant.id">Sample Approval Required</a><a class="lt-btn lt-btn--outline" href="/contact">Contact Sales</a></div>
                    </aside>
                </div>

                <div class="lt-detail-tabs-shell" data-lt-detail-tabs="">
                    <div class="lt-detail-tabs" role="tablist" aria-label="Product details"><button type="button" class="is-active" role="tab" id="lt-tab-overview" aria-selected="true" aria-controls="lt-panel-overview" data-lt-detail-tab="overview">Overview</button><button t-if="product.b2b_specifications" type="button" role="tab" id="lt-tab-specifications" aria-selected="false" aria-controls="lt-panel-specifications" data-lt-detail-tab="specifications">Specifications</button><button type="button" role="tab" id="lt-tab-resources" aria-selected="false" aria-controls="lt-panel-resources" data-lt-detail-tab="resources">Resources</button></div>
                    <div class="lt-detail-panels">
                        <section id="lt-panel-overview" class="lt-detail-panel is-active" role="tabpanel" aria-labelledby="lt-tab-overview" data-lt-detail-panel="overview"><span class="lt-kicker">OVERVIEW</span><h2>Product overview</h2><div t-if="product.description_ecommerce" class="lt-richtext" t-field="product.description_ecommerce"/><p t-else="" class="lt-muted">Contact our sales team for application guidance and solution design support.</p></section>
                        <section t-if="product.b2b_specifications" id="lt-panel-specifications" class="lt-detail-panel" role="tabpanel" aria-labelledby="lt-tab-specifications" data-lt-detail-panel="specifications" hidden="hidden"><span class="lt-kicker">SPECIFICATIONS</span><h2>Technical information</h2><div class="lt-richtext lt-specs" t-field="product.b2b_specifications"/></section>
                        <section id="lt-panel-resources" class="lt-detail-panel" role="tabpanel" aria-labelledby="lt-tab-resources" data-lt-detail-panel="resources" hidden="hidden"><span class="lt-kicker">RESOURCES</span><h2>Technical documents</h2>
                        <div t-if="resources" class="lt-resource-list"><article t-foreach="resources" t-as="resource" class="lt-resource-card"><div class="lt-resource-card__icon">PDF</div><div><h3 t-out="resource.name"/><p><span t-if="resource.b2b_version">v<t t-out="resource.b2b_version"/> · </span><span t-if="resource.b2b_language"><t t-out="resource.b2b_language"/> · </span><span t-out="(resource.mimetype or 'File').split('/')[-1].upper()"/><span t-if="resource.file_size"> · <t t-out="'%.1f MB' % (resource.file_size / 1048576.0)"/></span></p></div><a class="lt-btn lt-btn--outline lt-btn--small" t-att-href="'/products/resource/%s' % resource.id">Download</a></article></div>
                        <div t-else="" class="lt-empty lt-empty--compact"><p>No resources are available for your access level.</p></div>
                        </section>
                    </div>
                </div>
                <section t-if="related" class="lt-related"><span class="lt-kicker">RELATED</span><h2>Related products</h2><t t-set="products" t-value="related"/><t t-set="prices" t-value="related_prices"/><div class="lt-product-grid lt-product-grid--featured"><t t-foreach="products" t-as="product"><t t-call="b2b_website.product_card"/></t></div></section>
            </div></section>
        </t>
    </template>
</odoo>
