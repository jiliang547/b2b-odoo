<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="service_request_form" name="Partner Service Request">
        <t t-call="b2b_website.partner_layout">
            <t t-set="no_index" t-value="True"/>
            <section class="lt-page-head lt-page-head--compact"><div class="container"><span class="lt-kicker">AFTER-SALES</span><h1>Repair or replacement request</h1><p>Submit an issue against one of your confirmed Lucky Tone orders.</p></div></section>
            <section class="lt-section"><div class="container lt-form-shell">
                <div t-if="error" class="lt-alert lt-alert--error" role="alert"><strong>We could not submit your request.</strong><span t-out="error"/></div>
                <div t-if="not orders" class="lt-empty"><h2>No eligible orders</h2><p>A confirmed or completed order is required before creating an after-sales request.</p><a class="lt-btn lt-btn--ghost-dark" href="/my/orders">View my orders</a></div>
                <form t-else="" class="lt-form-card" action="/service" method="post" enctype="multipart/form-data" data-lt-submit-once="">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="submission_token" t-att-value="submission_token"/>
                    <div class="lt-form-section"><div><span>01</span><h2>Issue</h2></div><div class="lt-form-grid">
                        <fieldset class="lt-field lt-field--wide"><legend>Request type</legend><div class="lt-choice-row"><label><input type="radio" name="request_type" value="repair" required="required"/> Repair</label><label><input type="radio" name="request_type" value="replacement" required="required"/> Replacement</label></div></fieldset>
                        <div class="lt-field"><label for="service-order">Order number</label><select id="service-order" name="order_id" required="required"><option value="">Select an order</option><option t-foreach="orders" t-as="order" t-att-value="order.id" t-out="order.name"/></select></div>
                        <div class="lt-field"><label for="service-product">Product</label><select id="service-product" name="product_id" required="required" data-lt-service-product=""><option value="">Select an order first</option><option t-foreach="service_order_lines" t-as="line" t-att-value="line.product_id.id" t-att-data-order-id="line.order_id.id" t-out="line.product_id.display_name" hidden="hidden"/></select></div>
                        <div class="lt-field"><label for="service-model">Model number</label><input id="service-model" name="model_number" maxlength="160" required="required" t-att-value="post.get('model_number', '')" placeholder="Model or part number"/></div>
                        <div class="lt-field"><label for="service-serial">Serial number</label><input id="service-serial" name="serial_number" maxlength="160" t-att-value="post.get('serial_number', '')"/></div>
                        <div class="lt-field lt-field--wide"><label for="service-description">Problem description</label><textarea id="service-description" name="description" maxlength="8000" required="required" t-out="post.get('description', '')"/></div>
                        <div class="lt-field lt-field--wide"><label for="service-files">Attachments</label><input id="service-files" name="attachments" type="file" multiple="multiple" accept=".pdf,.png,.jpg,.jpeg,.zip"/><p class="lt-help">Up to 5 files, 10 MB each. PDF, PNG, JPEG or ZIP.</p></div>
                    </div></div>
                    <div class="lt-form-section"><div><span>02</span><h2>Contact</h2></div><div class="lt-form-grid">
                        <div class="lt-field"><label for="service-contact">Contact name</label><input id="service-contact" name="contact_name" maxlength="160" required="required" t-att-value="post.get('contact_name', contact_name)"/></div>
                        <div class="lt-field"><label for="service-company">Company</label><input id="service-company" name="company_name" maxlength="200" required="required" t-att-value="post.get('company_name', company_name)"/></div>
                        <div class="lt-field"><label for="service-email">Email</label><input id="service-email" name="email" type="email" maxlength="254" required="required" t-att-value="post.get('email', email)"/></div>
                        <div class="lt-field"><label for="service-phone">Phone</label><input id="service-phone" name="phone" maxlength="64" required="required" t-att-value="post.get('phone', phone)"/></div>
                    </div></div>
                    <div class="lt-form-submit"><p>Your request will create a Helpdesk ticket visible in My Account.</p><button class="lt-btn lt-btn--primary" type="submit" data-lt-submitting-label="Submitting…">Submit service request</button></div>
                </form>
            </div></section>
        </t>
    </template>

    <template id="order_erp_status" name="ERP Order Status">
        <t t-call="b2b_website.partner_layout"><t t-set="no_index" t-value="True"/>
            <section class="lt-page-head lt-page-head--compact"><div class="container"><span class="lt-kicker">ORDER TRACKING</span><h1 t-out="order.name"/><p>ERP fulfilment progress</p></div></section>
            <section class="lt-section"><div class="container lt-narrow">
                <div t-if="error" class="lt-state-card lt-state-card--error"><i class="fa fa-exclamation-circle"/><h2>Tracking temporarily unavailable</h2><p t-out="error"/><a class="lt-btn lt-btn--ghost-dark" t-att-href="'/my/orders/%s/erp-status' % order.id">Try again</a></div>
                <div t-elif="status" class="lt-status-panel"><div class="lt-status-panel__head"><div><span>Current status</span><h2 t-out="status.get('current_stage')"/></div><time t-if="status.get('updated_at')" t-out="status.get('updated_at')"/></div><ol t-if="status.get('timeline')" class="lt-timeline"><li t-foreach="status.get('timeline')" t-as="event" t-att-class="'is-complete' if event.get('complete') else ''"><span/><div><strong t-out="event.get('label')"/><time t-if="event.get('time')" t-out="event.get('time')"/></div></li></ol><div t-else="" class="lt-empty lt-empty--compact"><p>ERP has not returned timeline events yet.</p></div><p t-if="status.get('tracking_number')"><strong>Tracking number:</strong> <t t-out="status.get('tracking_number')"/></p></div>
            </div></section>
        </t>
    </template>
</odoo>
