<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_b2b_operator" model="res.groups">
        <field name="name">B2B Operator</field>
        <field name="comment">Base internal access to Partner Hub operational records.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_b2b_manager" model="res.groups">
        <field name="name">B2B Manager</field>
        <field name="comment">Approve customers and samples and configure Partner Hub business rules.</field>
        <field name="implied_ids" eval="[Command.link(ref('b2b_core.group_b2b_operator'))]"/>
    </record>

    <record id="group_b2b_special_price_manager" model="res.groups">
        <field name="name">B2B Special Price Manager</field>
        <field name="comment">Dedicated authorization for sensitive pricelist maintenance.</field>
        <field name="implied_ids" eval="[Command.link(ref('b2b_core.group_b2b_manager'))]"/>
    </record>

    <record id="group_b2b_product_manager" model="res.groups">
        <field name="name">B2B Product Manager</field>
        <field name="implied_ids" eval="[Command.link(ref('b2b_core.group_b2b_operator'))]"/>
    </record>

    <record id="group_b2b_marketing_media" model="res.groups">
        <field name="name">B2B Marketing Media</field>
        <field name="implied_ids" eval="[Command.link(ref('b2b_core.group_b2b_operator'))]"/>
    </record>

    <record id="group_b2b_pmc" model="res.groups">
        <field name="name">B2B PMC</field>
        <field name="implied_ids" eval="[Command.link(ref('b2b_core.group_b2b_operator'))]"/>
    </record>

    <record id="group_b2b_after_sales" model="res.groups">
        <field name="name">B2B After-sales</field>
        <field name="implied_ids" eval="[Command.link(ref('b2b_core.group_b2b_operator'))]"/>
    </record>

    <!-- Extend the native public template rule rather than adding a second
         group rule: group-scoped rules are OR-combined in Odoo. -->
    <record id="website_sale.product_template_public" model="ir.rule">
        <field name="domain_force">[('website_published', '=', True), ('sale_ok', '=', True)] + ([('b2b_visibility_mode', '=', 'all')] if not user.b2b_partner_approved else ['|', '|', ('b2b_visibility_mode', '=', 'all'), ('b2b_visibility_mode', '=', 'approved'), '&amp;', ('b2b_visibility_mode', '=', 'segments'), ('b2b_visible_segment_ids', 'in', user.b2b_partner_segment_ids.ids)])</field>
    </record>

    <record id="rule_b2b_product_variant_public_portal" model="ir.rule">
        <field name="name">Partner Hub product variant visibility</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="groups" eval="[Command.link(ref('base.group_public')), Command.link(ref('base.group_portal'))]"/>
        <field name="domain_force">[('product_tmpl_id.website_published', '=', True), ('product_tmpl_id.sale_ok', '=', True)] + ([('product_tmpl_id.b2b_visibility_mode', '=', 'all')] if not user.b2b_partner_approved else ['|', '|', ('product_tmpl_id.b2b_visibility_mode', '=', 'all'), ('product_tmpl_id.b2b_visibility_mode', '=', 'approved'), '&amp;', ('product_tmpl_id.b2b_visibility_mode', '=', 'segments'), ('product_tmpl_id.b2b_visible_segment_ids', 'in', user.b2b_partner_segment_ids.ids)])</field>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
</odoo>
