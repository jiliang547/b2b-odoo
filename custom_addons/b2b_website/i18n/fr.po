"                    <p>This link expires in 24 hours. If you did not submit this registration, you can ignore this email.</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"font-family:Arial,sans-serif;color:#111827;line-height:1.6\">\n"
"                    <p>Bonjour <t t-out=\"object.full_name\"/>,</p>\n"
"                    <p>Merci de vous être inscrit au portail partenaires POWER &amp; GRACE. Confirmez votre e-mail professionnel avant l’examen de votre demande par notre équipe.</p>\n"
"                    <p style=\"margin:24px 0\"><a t-att-href=\"object.get_verification_url()\" style=\"background:#E8380C;color:#fff;text-decoration:none;padding:12px 22px;border-radius:6px;font-weight:700\">Vérifier l’e-mail</a></p>\n"
"                    <p>Ce lien expire dans 24 heures. Si vous n’êtes pas à l’origine de cette inscription, ignorez cet e-mail.</p>\n"
"                </div>\n"
"            "

#. module: b2b_website
#: model:mail.template,body_html:b2b_website.mail_template_registration_rejected
