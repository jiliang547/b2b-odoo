<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="partner_footer" name="Partner Hub Footer">
        <footer class="lt-footer"><div class="container lt-footer__grid">
            <div class="lt-footer__about"><a class="lt-brand lt-brand--footer" href="/"><span class="lt-brand__mark" aria-hidden="true"><img src="/b2b_website/static/src/img/power_grace_logo.png" alt=""/></span><span><strong>POWER &amp; GRACE</strong><small>PARTNER HUB</small></span></a><p>Global B2B supply portal for professional audio and electronics. Partner pricing, sample evaluation, repair service, and up to 5-year warranty.</p><div class="lt-footer__social"><a href="/contact" aria-label="Email Power and Grace"><i class="fa fa-envelope"/></a><a href="/contact" aria-label="Contact Power and Grace"><i class="fa fa-linkedin"/></a></div></div>
            <div><h2>Products</h2><a href="/products">All Products</a><t t-set="lt_footer_categories" t-value="request.env['product.public.category'].search([('parent_id', '=', False), ('website_id', 'in', [False, website.id]), ('has_published_products', '=', True)], limit=4, order='sequence,name,id')"/><a t-foreach="lt_footer_categories" t-as="category" t-att-href="'/products?category=%s' % category.id" t-out="category.name"/></div>
            <div><h2>Services</h2><a href="/repair-service">Project Support</a><a href="/warranty">Warranty Policy</a><a t-att-href="'/samples' if not request.env.user._is_public() else '/web/login?redirect=/samples'">Sample Request</a><a href="/contact">After-Sales Support</a><a t-att-href="'/my/orders' if not request.env.user._is_public() else '/web/login?redirect=/my/orders'">Order Tracking</a></div>
            <div><h2>Company</h2><a href="/#our-brands">Our Brands</a><a href="/about">About Us</a><a href="/contact">Contact Sales</a><a href="/partner-application">Partner Program</a></div>
        </div><div class="container lt-footer__bottom"><span>© <t t-out="request.env.company.name"/>. All rights reserved.</span><span class="lt-erp-note"><i class="fa fa-circle"/> Powered by Odoo ERP</span></div></footer>
    </template>

    <template id="partner_layout" name="Lucky Tone Partner Hub Layout">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/>
            <div class="lt-hub"><t t-call="b2b_website.partner_topbar"/><main id="main" tabindex="-1"><t t-out="0"/></main>
                <t t-call="b2b_website.partner_footer"/>
            </div>
        </t>
    </template>

    <template id="partner_auth_layout" name="Partner Hub Authentication Layout">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/>
            <div class="lt-auth-page"><t t-call="b2b_website.partner_topbar"/><main class="lt-auth-main"><div class="container"><div class="lt-auth-card"><t t-out="0"/></div></div></main><t t-call="b2b_website.partner_footer"/></div>
        </t>
    </template>

    <template id="price_display" name="Partner Price Display">
        <t t-set="price" t-value="price or {}"/>
        <div t-att-class="'lt-price lt-price--%s' % (price.get('state') or 'contact')" t-att-data-lt-price-state="price.get('state') or 'contact'">
            <t t-if="price.get('state') == 'visible'"><span>Partner price</span><strong data-lt-price-value="" t-out="price.get('price')" t-options="{'widget': 'monetary', 'display_currency': price.get('currency')}"/><small>/ <span data-lt-price-uom="" t-out="price.get('uom_name') or 'unit'"/></small></t>
            <t t-elif="price.get('state') == 'login'"><a t-att-href="'/web/login?redirect=%s' % request.httprequest.path">Sign in to view price</a></t>
            <t t-else=""><a href="/contact">Contact sales for pricing</a></t>
        </div>
    </template>

    <template id="product_card" name="Partner Product Card">
        <t t-set="variant" t-value="product.product_variant_id"/><t t-set="price" t-value="prices.get(product.id)"/>
        <t t-set="procurement" t-value="request.env['b2b.product.service'].procurement_info(variant, pricelist=request.pricelist, website=website) if variant else {}"/>
        <article class="lt-product-card">
            <a class="lt-product-card__image" t-att-href="'/products/%s' % request.env['ir.http']._slug(product)"><span class="lt-status-badge lt-status-badge--available">Partner Catalog</span><img t-att-src="'/web/image/product.template/%s/image_512' % product.id" t-att-alt="product.name" loading="lazy"/></a>
            <div class="lt-product-card__body"><span class="lt-product-card__category" t-out="product.public_categ_ids[:1].name if product.public_categ_ids else 'Professional Audio'"/><h3><a t-att-href="'/products/%s' % request.env['ir.http']._slug(product)" t-out="product.name"/></h3><p class="lt-product-card__model">SKU: <span t-out="product.b2b_model_number or variant.default_code or 'On request'"/></p><p class="lt-product-card__description" t-out="product.description_sale or 'Industrial-grade solution for professional projects.'"/><t t-call="b2b_website.price_display"/>
                <div class="lt-product-card__actions"><a class="lt-btn lt-btn--outline lt-btn--small" t-att-href="'/products/%s' % request.env['ir.http']._slug(product)">Details</a><form t-if="price.get('state') == 'visible' and variant and product.product_variant_count == 1" class="lt-card-cart" data-lt-cart-form=""><input type="hidden" name="product_template_id" t-att-value="product.id"/><input type="hidden" name="product_id" t-att-value="variant.id"/><input type="hidden" name="uom_id" t-att-value="variant.uom_id.id"/><input type="hidden" name="add_qty" t-att-min="procurement.get('minimum_quantity', 1)" max="10000" t-att-step="procurement.get('quantity_step', 1)" t-att-value="procurement.get('minimum_quantity', 1)"/><button class="lt-btn lt-btn--blue lt-btn--small" type="submit"><i class="fa fa-shopping-cart"/> Add</button><span class="lt-cart-form__status" data-lt-cart-status="" aria-live="polite"/></form><a t-elif="price.get('state') == 'visible' and product.product_variant_count &gt; 1" class="lt-btn lt-btn--blue lt-btn--small" t-att-href="'/products/%s' % request.env['ir.http']._slug(product)">Select options</a></div>
                <a class="lt-compare-link" t-att-href="'/products/compare?ids=%s' % product.id"><i class="fa fa-balance-scale"/> Add to comparison</a>
            </div>
        </article>
    </template>

    <template id="partner_hub_homepage" name="Partner Hub Homepage">
        <t t-call="b2b_website.partner_layout">
            <section class="lt-hero"><div class="container lt-hero__grid">
                <div class="lt-hero__copy"><span class="lt-eyebrow"><i class="fa fa-circle"/> B2B PARTNER PORTAL</span><h1>Industrial Supply<br/><em>Built for Scale</em></h1><p>Lucky Tone Partner Hub connects distributors, OEMs, and procurement teams with a curated industrial catalog, certified specifications, and dedicated B2B support.</p><div class="lt-actions"><a class="lt-btn lt-btn--lime" href="/products">Browse Products <i class="fa fa-arrow-right"/></a><a class="lt-btn lt-btn--outline-dark" t-att-href="'/samples' if not request.env.user._is_public() else '/web/login?redirect=/samples'">Request Samples</a></div></div>
                <div class="lt-hero__visual"><div class="lt-hero__image"><img t-if="products" t-att-src="'/web/image/product.template/%s/image_1024' % products[0].id" t-att-alt="products[0].name"/><i t-else="" class="fa fa-industry"/></div><div class="lt-hero__float"><strong>Enterprise-ready</strong><span>From evaluation to after-sales</span></div></div>
            </div></section>
            <section class="lt-stat-strip"><div class="container"><article><i class="fa fa-cubes"/><div><strong t-out="catalog_total"/><span>Product Categories</span></div></article><article><i class="fa fa-globe"/><div><strong>1,200+</strong><span>Global Partners</span></div></article><article><i class="fa fa-diamond"/><div><strong>18+</strong><span>Years Experience</span></div></article><article><i class="fa fa-bolt"/><div><strong>&lt;4h</strong><span>Response Time</span></div></article></div></section>
            <section class="lt-home-section"><div class="container"><div class="lt-section-heading"><div><span class="lt-kicker">EXPLORE THE RANGE</span><h2>Product categories</h2><p>Solutions engineered for commercial and industrial audio projects.</p></div><a href="/products">View all products <i class="fa fa-arrow-right"/></a></div><div t-if="categories" class="lt-category-grid"><a t-foreach="categories[:6]" t-as="category" t-att-href="'/products?category=%s' % category.id"><span class="lt-category-grid__icon"><i class="fa fa-volume-up"/></span><strong t-out="category.name"/><small>Explore solutions <i class="fa fa-arrow-right"/></small></a></div><div t-else="" class="lt-empty"><p>Published product categories will appear here.</p></div></div></section>
            <section class="lt-home-section lt-home-section--soft"><div class="container"><div class="lt-section-heading"><div><span class="lt-kicker">RECOMMENDED</span><h2>Recommended Products</h2><p>Top components available to verified B2B customers.</p></div><a href="/products">All products <i class="fa fa-arrow-right"/></a></div><div t-if="products" class="lt-product-grid lt-product-grid--featured"><t t-foreach="products[:3]" t-as="product"><t t-call="b2b_website.product_card"/></t></div></div></section>
            <section class="lt-home-section"><div class="container"><div class="lt-section-heading lt-section-heading--center"><div><span class="lt-kicker">HOW IT WORKS</span><h2>How B2B Procurement Works</h2><p>From discovery to delivery — streamlined for industrial procurement teams.</p></div></div><div class="lt-process"><article><b>01</b><i class="fa fa-search"/><h3>Browse &amp; Discover</h3><p>Search products with certified specifications and account visibility.</p></article><article><b>02</b><i class="fa fa-flask"/><h3>Request &amp; Evaluate</h3><p>Apply for samples and review approved technical documentation.</p></article><article><b>03</b><i class="fa fa-shopping-cart"/><h3>Confirm &amp; Order</h3><p>Place B2B orders with your negotiated Odoo pricing.</p></article><article><b>04</b><i class="fa fa-truck"/><h3>Track &amp; Deliver</h3><p>Monitor order, ERP sync and post-delivery support.</p></article></div></div></section>
            <section class="lt-home-section lt-home-section--dark"><div class="container"><div class="lt-section-heading"><div><span class="lt-kicker">ENTERPRISE CAPABILITIES</span><h2>Built around your operation</h2></div></div><div class="lt-capability-grid"><article><i class="fa fa-tags"/><h3>Account pricing</h3><p>Prices are calculated from your assigned Odoo pricelist.</p></article><article><i class="fa fa-file-text-o"/><h3>Controlled resources</h3><p>Permission-aware manuals and technical downloads.</p></article><article><i class="fa fa-cubes"/><h3>Company workspace</h3><p>Orders, users, samples and support grouped by company.</p></article><article><i class="fa fa-refresh"/><h3>ERP visibility</h3><p>Read-only fulfilment status without exposing internal controls.</p></article></div></div></section>
            <section class="lt-partner-cta"><div class="container"><div><span class="lt-kicker">PARTNER WITH LUCKY TONE</span><h2>Ready to scale your next project?</h2><p>Apply for access to pricing, samples and dedicated partner support.</p></div><div class="lt-actions"><a class="lt-btn lt-btn--lime" href="/partner-application">Become a Partner</a><a class="lt-btn lt-btn--light" href="/contact">Talk to Sales</a></div></div></section>
        </t>
    </template>
</odoo>
