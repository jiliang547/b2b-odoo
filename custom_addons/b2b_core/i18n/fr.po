#: model:ir.model.fields,field_description:b2b_core.field_res_users__b2b_approved
#: model_terms:ir.ui.view,arch_db:b2b_core.view_partner_form_b2b
msgid "Partner Hub Approved"
msgstr "Accès partenaire approuvé"
