msgid "System Integrator"
msgstr "متكامل أنظمة"

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/services/product_service.py:0
msgid "The minimum order quantity for this product is %(minimum)g."
msgstr "الحد الأدنى لطلب هذا المنتج هو %(minimum)g."

#. module: b2b_core
#: model:ir.model.fields.selection,name:b2b_core.selection__product_document__b2b_resource_type__manual
msgid "User Manual"
msgstr "دليل المستخدم"

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/customer_type.py:0
msgid ""
"A generated customer effective pricelist cannot be used as a base pricelist."
msgstr "لا يمكن استخدام قائمة أسعار العميل الفعلية المولّدة كقائمة أساسية."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/partner_pricing.py:0
msgid ""
"A generated customer effective pricelist cannot be used as an override."
msgstr "لا يمكن استخدام قائمة أسعار العميل الفعلية المولّدة كتجاوز مخصص."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/customer_type.py:0
msgid ""
"Archive customer types instead of deleting types that have base pricelists."
msgstr "أرشف أنواع العملاء ذات قوائم الأسعار الأساسية بدلًا من حذفها."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/price_security.py:0
msgid ""
"B2B Special Price Managers can update prices, but not product master data."
msgstr ""
"يمكن لمديري الأسعار الخاصة للشركات تحديث الأسعار لا بيانات المنتجات "
"الأساسية."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/partner_pricing.py:0
msgid "Company price overrides must be assigned to the commercial account."
msgstr "يجب إسناد أسعار الشركة المخصصة إلى الحساب التجاري."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/partner_pricing.py:0
msgid ""
"Configure a base pricelist for this customer type, website, and currency "
"before adding a company override."
msgstr ""
"اضبط قائمة أسعار أساسية لنوع العميل والموقع والعملة قبل إضافة أسعار شركة "
"مخصصة."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/price_security.py:0
msgid ""
"Deactivate the customer-type base mapping before archiving its pricelist."
msgstr "عطّل ربط القائمة الأساسية بنوع العميل قبل أرشفة قائمة الأسعار."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/product_template.py:0
msgid "Default B2B MOQ must be greater than zero."
msgstr "يجب أن يكون الحد الأدنى الافتراضي لطلب الشركات أكبر من صفر."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid "Only a B2B Manager can approve Partner Hub customers."
msgstr "يمكن لمدير B2B فقط اعتماد عملاء بوابة الشركاء."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid ""
"Only a B2B Manager can maintain customer type, segments, and ERP customer "
"data."
msgstr "يمكن لمدير B2B فقط إدارة نوع العميل وشرائحه وبياناته في ERP."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid "Only a B2B Manager can revoke Partner Hub access."
msgstr "يمكن لمدير B2B فقط إلغاء الوصول إلى البوابة."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid ""
"Only a B2B Manager or B2B Special Price Manager can assign customer "
"pricelists."
msgstr ""
"يمكن لمدير B2B أو مدير الأسعار الخاصة B2B فقط تعيين قوائم أسعار العملاء."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid ""
"Partner Hub approval must be changed with the Approve or Revoke action."
msgstr "يجب تغيير اعتماد البوابة باستخدام إجراء الموافقة أو الإلغاء."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/res_partner.py:0
msgid ""
"Partner Hub approval, customer type, segments, and ERP customer data must be"
" maintained on the commercial company record."
msgstr ""
"يجب إدارة الاعتماد ونوع العميل والشرائح وبيانات ERP على سجل الشركة التجارية."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/services/product_service.py:0
msgid "Quantity must start at %(minimum)g and increase in steps of %(step)g."
msgstr "يجب أن تبدأ الكمية من %(minimum)g وتزيد بمقدار %(step)g."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/price_security.py:0
msgid ""
"Remove this pricelist from customer-type and company pricing before changing"
" its currency."
msgstr ""
"أزل قائمة الأسعار هذه من تسعير أنواع العملاء والشركات قبل تغيير عملتها."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/customer_type.py:0
msgid "The base pricelist and website must belong to the same company."
msgstr "يجب أن تنتمي قائمة الأسعار الأساسية والموقع إلى الشركة نفسها."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/partner_pricing.py:0
msgid "The override pricelist and website must belong to the same company."
msgstr "يجب أن تنتمي قائمة الأسعار المخصصة والموقع إلى الشركة نفسها."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/partner_pricing.py:0
msgid ""
"The selected customer type has no active base pricelist for an existing "
"company override."
msgstr ""
"لا توجد قائمة أساسية نشطة لنوع العميل المحدد لأحد أسعار الشركة المخصصة "
"القائمة."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/customer_type.py:0
msgid ""
"This base pricelist is required by active company overrides. Remove or "
"deactivate those overrides first."
msgstr ""
"تتطلب أسعار الشركة المخصصة النشطة هذه القائمة الأساسية. أزلها أو عطّلها "
"أولًا."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/price_security.py:0
msgid "You are not authorized to maintain B2B prices."
msgstr "لست مخولًا بإدارة أسعار الشركات."

#. module: b2b_core
#. odoo-python
#: code:addons/b2b_core/models/partner_pricing.py:0
msgid "[B2B Effective] %(customer)s / %(currency)s"
msgstr "[B2B الفعلي] %(customer)s / %(currency)s"

