<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="partner_topbar" name="Partner Hub Topbar">
        <nav class="lt-subnav" aria-label="Partner Hub navigation">
            <div class="container lt-subnav__inner">
                <a class="lt-brand" href="/" aria-label="Lucky Tone home">
                    <span class="lt-brand__mark" aria-hidden="true">LT</span>
                    <span><strong>LUCKY TONE</strong><small>PARTNER HUB</small></span>
                </a>
                <button class="lt-nav-toggle" type="button" aria-expanded="false" aria-controls="lt-native-navigation">
                    <span class="visually-hidden">Toggle navigation</span><i class="fa fa-bars" aria-hidden="true"/>
                </button>
                <div id="lt-native-navigation" class="lt-nav-shell">
                    <div class="lt-nav-links">
                        <a t-att-class="'is-active' if request.httprequest.path.startswith('/products') else ''" href="/products">Products</a>
                        <a t-att-class="'is-active' if request.httprequest.path.startswith('/solutions') else ''" href="/solutions">Solutions</a>
                        <a t-att-class="'is-active' if request.httprequest.path.startswith('/resources') else ''" href="/resources">Resources</a>
                        <a t-att-class="'is-active' if request.httprequest.path.startswith('/about') else ''" href="/about">About</a>
                        <a t-att-class="'is-active' if request.httprequest.path.startswith('/contact') else ''" href="/contact">Contact</a>
                    </div>
                    <div class="lt-nav-actions">
                        <form class="lt-header-search" action="/products" method="get" role="search">
                            <label class="visually-hidden" for="lt-header-search">Search products</label>
                            <i class="fa fa-search" aria-hidden="true"/><input id="lt-header-search" type="search" name="search" placeholder="Search products…"/><kbd>⌘K</kbd>
                        </form>
                        <t t-set="website_sale_cart_quantity" t-value="request.session.get('website_sale_cart_quantity', request.cart.cart_quantity) or 0"/>
                        <li class="o_wsale_my_cart lt-header-cart-item">
                            <a class="lt-icon-link" href="/shop/cart" aria-label="Shopping cart">
                                <i class="fa fa-shopping-cart"/>
                                <sup t-attf-class="my_cart_quantity badge bg-primary #{'d-none' if website_sale_cart_quantity == 0 else ''}" t-out="website_sale_cart_quantity" t-att-data-order-id="request.session.get('sale_order_id', None) if website_sale_cart_quantity else None"/>
                            </a>
                        </li>
                        <a t-if="request.env.user._is_public()" class="lt-btn lt-btn--outline-dark lt-btn--nav" href="/web/login?redirect=/my">Sign in</a>
                        <t t-else="">
                            <details class="lt-account-menu"><summary><span class="lt-account-menu__avatar" t-out="(request.env.user.name or 'U')[:1].upper()"/><span><strong t-out="request.env.user.name"/><small>My Account</small></span><i class="fa fa-angle-down"/></summary>
                                <div class="lt-account-menu__panel"><div><strong t-out="request.env.user.partner_id.commercial_partner_id.name"/><small t-out="request.env.user.email or request.env.user.login"/></div><a href="/my"><i class="fa fa-th-large"/> Dashboard</a><a href="/my/account"><i class="fa fa-user"/> Profile</a><a href="/my/orders"><i class="fa fa-shopping-bag"/> Orders</a><a href="/samples"><i class="fa fa-flask"/> Samples</a><a href="/service-center"><i class="fa fa-life-ring"/> Service</a><a class="lt-logout-link" href="/web/session/logout?redirect=/"><i class="fa fa-sign-out"/> Sign Out</a></div>
                            </details>
                        </t>
                    </div>
                </div>
            </div>
        </nav>
    </template>

    <template id="partner_portal_sidebar" name="Partner Portal Sidebar">
        <aside class="lt-account-sidebar">
            <nav aria-label="Account navigation">
                <a t-att-class="'is-active' if page_name == 'home' else ''" href="/my"><i class="fa fa-th-large"/>Overview</a>
                <a t-att-class="'is-active' if page_name in ('order', 'quote') else ''" href="/my/orders"><i class="fa fa-shopping-bag"/>Orders</a>
                <a t-att-class="'is-active' if page_name in ('sample_requests', 'sample_request_detail') else ''" href="/my/sample-requests"><i class="fa fa-flask"/>Samples</a>
                <a t-att-class="'is-active' if page_name in ('ticket', 'service_center') else ''" href="/my/tickets"><i class="fa fa-life-ring"/>Service</a>
                <span class="lt-account-sidebar__divider"/>
                <a t-att-class="'is-active' if page_name == 'company_profile' else ''" href="/my/company"><i class="fa fa-building"/>Company profile</a>
                <a t-att-class="'is-active' if page_name == 'company_users' else ''" href="/my/company/users"><i class="fa fa-users"/>Company users</a>
                <a t-att-class="'is-active' if page_name == 'my_details' else ''" href="/my/account"><i class="fa fa-user"/>Personal profile</a>
                <a t-att-class="'is-active' if page_name == 'addresses' else ''" href="/my/addresses"><i class="fa fa-map-marker"/>Addresses</a>
            </nav>
            <div class="lt-account-sidebar__footer"><div class="lt-account-sidebar__help"><strong>Need Help?</strong><p>Our partner support team is ready to assist.</p><a href="/contact">Contact Support →</a></div><a class="lt-account-sidebar__logout" href="/web/session/logout?redirect=/" aria-label="Log out of the current account"><i class="fa fa-sign-out"/>Sign Out</a></div>
        </aside>
    </template>

    <template id="partner_about" name="Partner About">
        <t t-call="b2b_website.partner_layout">
            <main class="lt-about-design">
                <section class="lt-about-design__hero">
                    <img class="lt-about-design__hero-image" src="/b2b_website/static/src/img/about-hero.jpg" alt="Lucky Tone manufacturing facility"/>
                    <div class="lt-about-design__hero-shade"/>
                    <div class="container lt-about-design__hero-content">
                        <span class="lt-about-design__eyebrow">ABOUT LUCKY TONE</span>
                        <h1>18 Years of Industrial Supply Chain Excellence</h1>
                        <p>Lucky Tone Industrial Co., Ltd. is a Suzhou-based manufacturer and global distributor of industrial electrical components, connectors, and power systems. We serve 1,200+ partners across 40+ countries.</p>
                        <a class="lt-btn lt-btn--lime" href="/contact">Contact Sales Team</a>
                    </div>
                </section>

                <section class="lt-about-design__mission">
                    <div class="container lt-about-design__mission-grid">
                        <div class="lt-about-design__mission-copy">
                            <h2>Our Mission</h2>
                            <p>To provide industrial procurement teams with world-class components, transparent pricing, and enterprise-grade digital tools that reduce supply chain complexity.</p>
                            <p>We believe B2B procurement should be as efficient as consumer e-commerce — with full traceability, certified specifications, and a direct line to our engineering team.</p>
                            <div class="lt-about-design__stats" aria-label="Company statistics">
                                <article><strong>18+</strong><span>Years Founded</span></article>
                                <article><strong>1,200+</strong><span>Global Partners</span></article>
                                <article><strong>40+</strong><span>Countries Served</span></article>
                                <article><strong>480+</strong><span>Products</span></article>
                            </div>
                        </div>
                        <img class="lt-about-design__mission-image" src="/b2b_website/static/src/img/about-production.jpg" alt="Production facility"/>
                    </div>
                </section>

                <section class="lt-about-design__quality">
                    <div class="container">
                        <div class="lt-about-design__section-heading"><h2>Quality &amp; Certifications</h2></div>
                        <div class="lt-about-design__certifications">
                            <article><span><i class="fa fa-check" aria-hidden="true"/></span><h3>ISO 9001:2015</h3><p>Full quality management system</p></article>
                            <article><span><i class="fa fa-certificate" aria-hidden="true"/></span><h3>CE Certified</h3><p>European market compliance</p></article>
                            <article><span><i class="fa fa-shield" aria-hidden="true"/></span><h3>UL Listed</h3><p>North American safety standards</p></article>
                            <article><span><i class="fa fa-leaf" aria-hidden="true"/></span><h3>RoHS Compliant</h3><p>Hazardous substance-free</p></article>
                        </div>
                    </div>
                </section>

                <section class="lt-about-design__milestones">
                    <div class="container">
                        <div class="lt-about-design__section-heading"><h2>Company Milestones</h2></div>
                        <ol class="lt-about-design__timeline">
                            <li><time>2006</time><p>Founded in Suzhou, Jiangsu, starting with industrial connector manufacturing</p></li>
                            <li><time>2009</time><p>ISO 9001 certification obtained; expanded to cable assembly production</p></li>
                            <li><time>2012</time><p>Opened European distribution hub in Frankfurt, Germany</p></li>
                            <li><time>2015</time><p>Launched custom OEM engineering services; 500+ products in catalog</p></li>
                            <li><time>2018</time><p>Established North America logistics hub in Chicago</p></li>
                            <li><time>2021</time><p>Launched B2B digital portal v1.0 with Odoo ERP integration</p></li>
                            <li><time>2024</time><p>Lucky Tone Partner Hub v2.0 — advanced B2B procurement platform</p></li>
                        </ol>
                    </div>
                </section>
            </main>
        </t>
    </template>

    <template id="partner_solutions" name="Partner Solutions">
        <t t-call="b2b_website.partner_layout">
            <section class="lt-page-hero"><div class="container"><nav class="lt-breadcrumb lt-breadcrumb--dark" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Solutions</span></nav><span class="lt-kicker">INDUSTRIAL SOLUTIONS</span><h1>Procurement support for every stage.</h1><p>Discover, evaluate, order and maintain industrial components through one Odoo-connected partner workflow.</p></div></section>
            <section class="lt-section lt-section--soft"><div class="container"><div class="lt-solution-grid">
                <article><span>01</span><i class="fa fa-search"/><h2>Product discovery</h2><p>Search certified products, compare specifications and access documents allowed for your partner segment.</p><a href="/products">Browse products <i class="fa fa-arrow-right"/></a></article>
                <article><span>02</span><i class="fa fa-flask"/><h2>Evaluation samples</h2><p>Request evaluation units and follow approval and ERP fulfilment from your account.</p><a t-att-href="'/samples' if not request.env.user._is_public() else '/web/login?redirect=/samples'">Request samples <i class="fa fa-arrow-right"/></a></article>
                <article><span>03</span><i class="fa fa-shopping-cart"/><h2>B2B ordering</h2><p>Use negotiated Odoo pricelists, native cart validation and the standard checkout workflow.</p><a href="/products">Start an order <i class="fa fa-arrow-right"/></a></article>
                <article><span>04</span><i class="fa fa-wrench"/><h2>After-sales service</h2><p>Create order-linked repair or replacement requests backed by Odoo Helpdesk.</p><a t-att-href="'/service-center' if not request.env.user._is_public() else '/web/login?redirect=/service-center'">Open service center <i class="fa fa-arrow-right"/></a></article>
            </div></div></section>
            <section class="lt-partner-cta"><div class="container"><div><span class="lt-kicker">NEED A CUSTOM SOLUTION?</span><h2>Talk with our B2B team.</h2><p>Share your project requirements, target volumes and delivery schedule.</p></div><a class="lt-btn lt-btn--lime" href="/contact">Contact Sales</a></div></section>
        </t>
    </template>

    <template id="partner_privacy" name="Partner Privacy Policy">
        <t t-call="b2b_website.partner_layout">
            <section class="lt-page-hero"><div class="container"><nav class="lt-breadcrumb lt-breadcrumb--dark" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Privacy</span></nav><span class="lt-kicker">PARTNER DATA</span><h1>Privacy Policy</h1><p>How information submitted through the Lucky Tone Partner Hub is used to operate your account and B2B services.</p></div></section>
            <section class="lt-section"><div class="container lt-legal-content">
                <h2>Information we process</h2><p>We process company, contact, account, order, sample and service information that you provide or generate while using the Partner Hub.</p>
                <h2>Why we use it</h2><p>This information supports account approval, negotiated pricing, order fulfilment, technical resources, sample evaluation, after-sales service and security.</p>
                <h2>Access and retention</h2><p>Access follows your Odoo company and user permissions. Records are retained according to operational, contractual and legal requirements.</p>
                <h2>Questions</h2><p>For privacy or account-data questions, contact the Lucky Tone team through the <a href="/contact">contact page</a>.</p>
            </div></section>
        </t>
    </template>

    <template id="partner_application" name="Partner Application">
        <t t-call="b2b_website.partner_layout"><t t-set="no_index" t-value="True"/>
            <section class="lt-page-head lt-page-head--compact"><div class="container"><span class="lt-kicker">PARTNER NETWORK</span><h1>Apply for Partner Hub access</h1><p>Tell us about your company and the markets you serve.</p></div></section>
            <section class="lt-section"><div class="container lt-form-shell">
                <div t-if="error" class="lt-alert lt-alert--warning" role="alert" t-out="error"/>
                <form action="/partner-application/submit" method="post" class="lt-form-card" data-lt-submit-once="">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="submission_token" t-att-value="submission_token"/>
                    <div class="lt-form-section"><div><span>01</span><h2>Company</h2></div><div class="lt-form-grid">
                        <div class="lt-field"><label for="pa-company">Legal company name</label><input id="pa-company" name="company_name" required="required" maxlength="200" t-att-value="form.get('company_name', '')"/></div>
                        <div class="lt-field"><label for="pa-country">Country / region</label><input id="pa-country" name="country_region" required="required" maxlength="160" t-att-value="form.get('country_region', '')"/></div>
                        <div class="lt-field"><label for="pa-website">Company website</label><input id="pa-website" name="company_website" type="url" maxlength="500" t-att-value="form.get('company_website', '')"/></div>
                        <div class="lt-field"><label for="pa-type">Business type</label><select id="pa-type" name="business_type" required="required"><option value="">Select</option><option t-att-selected="form.get('business_type') == 'Distributor'">Distributor</option><option t-att-selected="form.get('business_type') == 'System integrator'">System integrator</option><option t-att-selected="form.get('business_type') == 'Installer'">Installer</option><option t-att-selected="form.get('business_type') == 'Retailer'">Retailer</option><option t-att-selected="form.get('business_type') == 'Consultant'">Consultant</option></select></div>
                    </div></div>
                    <div class="lt-form-section"><div><span>02</span><h2>Primary contact</h2></div><div class="lt-form-grid">
                        <div class="lt-field"><label for="pa-name">Full name</label><input id="pa-name" name="contact_name" required="required" maxlength="160" t-att-value="form.get('contact_name', '')"/></div>
                        <div class="lt-field"><label for="pa-role">Role / title</label><input id="pa-role" name="job_title" maxlength="160" t-att-value="form.get('job_title', '')"/></div>
                        <div class="lt-field"><label for="pa-email">Business email</label><input id="pa-email" name="email" type="email" required="required" maxlength="254" t-att-value="form.get('email', '')"/></div>
                        <div class="lt-field"><label for="pa-phone">Phone</label><input id="pa-phone" name="phone" type="tel" required="required" maxlength="64" t-att-value="form.get('phone', '')"/></div>
                    </div></div>
                    <div class="lt-form-section"><div><span>03</span><h2>Partnership</h2></div><div class="lt-form-grid">
                        <div class="lt-field lt-field--wide"><label for="pa-markets">Markets, channels and project types</label><textarea id="pa-markets" name="description" required="required" maxlength="5000" t-out="form.get('description', '')"/></div>
                        <div class="lt-field lt-field--wide"><label><input type="checkbox" name="consent" value="1" required="required" t-att-checked="form.get('consent') == '1'"/> I confirm that the information is accurate and may be reviewed by Lucky Tone.</label></div>
                    </div></div>
                    <div class="lt-form-submit"><p>Submission sends a review request; access is activated only after staff approval.</p><button type="submit" class="lt-btn lt-btn--blue" data-lt-submitting-label="Submitting…">Submit application</button><span class="lt-submit-status" data-lt-submit-status="" aria-live="polite"/></div>
                </form>
            </div></section>
        </t>
    </template>

    <template id="product_comparison" name="Product Comparison">
        <t t-call="b2b_website.partner_layout"><section class="lt-catalog-page"><div class="container">
            <div class="lt-catalog-intro"><span class="lt-kicker">COMPARE</span><h1>Product comparison</h1><p>Compare visible products and your current account pricing.</p></div>
            <div t-if="not products" class="lt-empty"><h2>No products selected</h2><a class="lt-btn lt-btn--blue" href="/products">Browse products</a></div>
            <div t-else="" class="lt-compare-wrap"><table class="lt-compare-table"><thead><tr><th>Specification</th><th t-foreach="products" t-as="product"><img t-att-src="'/web/image/product.template/%s/image_256' % product.id" t-att-alt="product.name"/><strong t-out="product.name"/><small t-out="product.b2b_model_number or product.product_variant_id.default_code or ''"/></th></tr></thead><tbody>
                <tr><th>Partner price</th><td t-foreach="products" t-as="product"><t t-set="price" t-value="prices.get(product.id)"/><t t-call="b2b_website.price_display"/></td></tr>
                <tr><th>Category</th><td t-foreach="products" t-as="product" t-out="product.public_categ_ids[:1].name if product.public_categ_ids else '—'"/></tr>
                <tr><th>Catalog status</th><td t-foreach="products" t-as="product"><span class="lt-status-badge lt-status-badge--available">Partner Catalog</span></td></tr>
                <tr><th>Overview</th><td t-foreach="products" t-as="product" t-out="product.description_sale or 'Contact us for application guidance.'"/></tr>
                <tr><th>Action</th><td t-foreach="products" t-as="product"><a class="lt-btn lt-btn--outline lt-btn--small" t-att-href="'/products/%s' % request.env['ir.http']._slug(product)">View product</a></td></tr>
            </tbody></table></div>
        </div></section></t>
    </template>

    <template id="resource_center" name="Resource Center">
        <t t-call="b2b_website.partner_layout"><section class="lt-resources-page">
            <div class="lt-page-hero lt-page-hero--compact"><div class="container"><nav class="lt-breadcrumb lt-breadcrumb--dark" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Resources</span></nav><h1>Resource Center</h1><p>Product datasheets, certifications, technical guides, and approved partner materials.</p></div></div>
            <div class="container lt-resource-content">
                <section class="lt-resource-metrics" aria-label="Resource statistics"><article><strong t-out="resource_total"/><span>Total Documents</span></article><article><strong t-out="resource_pdf_total"/><span>PDF Documents</span></article><article><strong t-out="resource_category_total"/><span>Categories</span></article><article><strong t-out="resource_product_total"/><span>Products Covered</span></article></section>
                <form class="lt-resource-toolbar" action="/resources" method="get"><div class="lt-search"><label class="visually-hidden" for="resource-search">Search documents</label><i class="fa fa-search"/><input id="resource-search" type="search" name="search" t-att-value="search" placeholder="Search documents..."/></div><label class="visually-hidden" for="resource-category">Category</label><select id="resource-category" name="category"><option value="">All Categories</option><option t-foreach="resource_categories" t-as="item" t-att-value="item.id" t-att-selected="item.id == resource_category" t-out="item.name"/></select><label class="visually-hidden" for="resource-type">File type</label><select id="resource-type" name="file_type"><option value="">All Types</option><option t-foreach="resource_formats" t-as="item" t-att-value="item" t-att-selected="item == resource_type" t-out="item"/></select><button class="lt-btn lt-btn--blue" type="submit">Filter</button></form>
                <div class="lt-resource-count"><strong t-out="len(resources)"/> files</div>
                <div t-if="resources" class="lt-resource-library"><article t-foreach="resources" t-as="row" class="lt-library-card"><div t-att-class="'lt-library-card__icon lt-library-card__icon--%s' % row['format'].lower()"><i t-att-class="'fa ' + ('fa-file-archive-o' if row['format'] == 'ZIP' else 'fa-cube' if row['format'] == 'STEP' else 'fa-file-text-o')"/></div><div class="lt-library-card__copy"><h2 t-out="row['document'].name"/><p><span t-out="row['product'].b2b_model_number or row['product'].name"/><t t-if="row['document'].b2b_version"> · v<t t-out="row['document'].b2b_version"/></t></p><div class="lt-library-card__meta"><span t-if="row['category']" t-out="row['category'].name"/><span t-out="row['format']"/><span t-if="row['document'].file_size" t-out="'%.1f MB' % (row['document'].file_size / 1048576.0)"/><span t-if="row['document'].write_date">Updated <span t-field="row['document'].write_date" t-options="{'widget':'date'}"/></span></div></div><div class="lt-library-card__actions"><a class="lt-btn lt-btn--ghost lt-btn--small" t-att-href="'/resources/%s' % row['document'].id">Details</a><a class="lt-btn lt-btn--blue lt-btn--small" t-att-href="'/products/resource/%s' % row['document'].id"><i class="fa fa-download"/> Download</a></div></article></div>
                <div t-else="" class="lt-empty"><h2>No resources match</h2><p>Adjust the search or filters. Access is based on product visibility and partner approval.</p><a class="lt-btn lt-btn--outline" href="/resources">Clear filters</a></div>
            </div>
        </section></t>
    </template>

    <template id="resource_detail" name="Resource Detail">
        <t t-call="b2b_website.partner_layout"><section class="lt-section"><div class="container lt-resource-detail">
            <a class="lt-back-link" href="/resources">← Back to resources</a><div class="lt-resource-detail__grid">
                <div class="lt-resource-preview"><i class="fa fa-file-text-o"/><span t-out="(document.mimetype or 'File').split('/')[-1].upper()"/></div>
                <aside class="lt-resource-meta"><span class="lt-kicker">TECHNICAL RESOURCE</span><h1 t-out="document.name"/><p t-out="product.name"/><dl><dt>Model</dt><dd t-out="product.b2b_model_number or product.product_variant_id.default_code or '—'"/><dt>Version</dt><dd t-out="document.b2b_version or 'Current'"/><dt>Language</dt><dd t-out="document.b2b_language or 'Not specified'"/><dt>Format</dt><dd t-out="(document.mimetype or 'File').split('/')[-1].upper()"/></dl><a class="lt-btn lt-btn--blue lt-btn--wide" t-att-href="'/products/resource/%s' % document.id">Download resource</a></aside>
            </div>
        </div></section></t>
    </template>

    <template id="sample_center" name="Sample Center">
        <t t-call="b2b_website.partner_layout"><section class="lt-account-page"><div class="container">
            <nav class="lt-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Sample Center</span></nav><div class="lt-account-heading"><div><h1>Sample Center</h1><p>Request product samples for evaluation before bulk purchase.</p></div><a class="lt-btn lt-btn--blue" href="/sample/request">New Sample Request</a></div>
            <div class="lt-metrics lt-metrics--account lt-metrics--four"><article><strong t-out="sample_total"/><span>Total Requests</span><small>All time</small></article><article><strong t-out="sample_approved"/><span>Approved</span><small>Ready for fulfilment</small></article><article><strong t-out="sample_completed"/><span>ERP Synced</span><small>Completed requests</small></article><article><strong t-out="sample_pending"/><span>Pending</span><small>Under review</small></article></div>
            <div class="lt-center-layout"><div class="lt-account-card"><div class="lt-account-card__head"><div><h2>My Requests</h2><p><t t-out="sample_total"/> requests</p></div><a class="lt-btn lt-btn--blue lt-btn--small" href="/sample/request">New Request</a></div><div t-if="samples" class="lt-request-list"><a t-foreach="samples" t-as="sample" t-att-href="'/my/sample-requests/%s' % sample.id"><div><strong t-out="sample.name"/><span t-att-class="'lt-status-badge lt-status-badge--%s' % sample.state" t-out="dict(sample._fields['state'].selection).get(sample.state)"/></div><p t-out="', '.join(sample.line_ids.product_id.mapped('display_name'))"/><small><span t-field="sample.create_date" t-options="{'widget':'date'}"/> · <t t-out="sum(sample.line_ids.mapped('quantity'))"/> units</small></a></div><div t-else="" class="lt-empty lt-empty--compact"><p>No sample requests yet.</p></div></div><aside class="lt-program-card"><h3>Sample Program</h3><dl><dt>Product access</dt><dd>Only products visible to your approved partner segment.</dd><dt>Review</dt><dd>Requests are reviewed by the Lucky Tone product team.</dd><dt>Fulfilment</dt><dd>Approved requests are synchronized through the ERP queue.</dd><dt>Tracking</dt><dd>Current status stays available in your secure account.</dd></dl><a class="lt-btn lt-btn--blue lt-btn--wide" href="/sample/request">New Sample Request</a></aside></div>
        </div></section></t>
    </template>

    <template id="service_center" name="Service Center">
        <t t-call="b2b_website.partner_layout"><section class="lt-account-page"><div class="container">
            <div t-if="request.params.get('submitted')" class="lt-alert lt-alert--success">Your service request was submitted successfully.</div>
            <nav class="lt-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Service Center</span></nav><div class="lt-account-heading"><div><h1>Service Center</h1><p>Technical support, order help, and after-sales service.</p></div><a class="lt-btn lt-btn--blue" href="/service">New Service Request</a></div>
            <div class="lt-metrics lt-metrics--account lt-metrics--four"><article><strong t-out="ticket_open"/><span>Open Tickets</span><small>Active requests</small></article><article><strong t-out="ticket_in_progress"/><span>In Progress</span><small>Assigned cases</small></article><article><strong t-out="ticket_resolved"/><span>Resolved</span><small>Closed cases</small></article><article><strong t-out="ticket_unassigned"/><span>Unassigned</span><small>Awaiting owner</small></article></div>
            <div class="lt-center-layout"><div class="lt-account-card"><div class="lt-account-card__head"><div><h2>My Requests</h2><p><t t-out="ticket_total"/> requests</p></div><a class="lt-btn lt-btn--blue lt-btn--small" href="/service">New Request</a></div><div t-if="tickets" class="lt-request-list"><a t-foreach="tickets" t-as="ticket" t-att-href="'/helpdesk/ticket/%s' % ticket.id"><div><strong><t t-out="ticket.ticket_ref"/> · <t t-out="ticket.name"/></strong><span class="lt-status-badge" t-out="ticket.stage_id.name"/></div><p><t t-out="dict(ticket._fields['b2b_request_type'].selection).get(ticket.b2b_request_type) if ticket.b2b_request_type else 'Technical Support'"/> · <t t-out="'Assigned to %s' % ticket.user_id.name if ticket.user_id else 'Unassigned'"/></p><small t-field="ticket.create_date" t-options="{'widget':'date'}"/></a></div><div t-else="" class="lt-empty lt-empty--compact"><p>No service requests yet.</p></div></div><aside class="lt-program-card"><h3>Quick Contact</h3><dl><dt>Partner support</dt><dd t-out="request.env.company.email or 'Use the contact form for assistance.'"/><dt>Telephone</dt><dd t-out="request.env.company.phone or 'Available from your account manager.'"/><dt>Order-linked support</dt><dd>Repair and replacement requests must reference one of your confirmed orders.</dd></dl><a class="lt-btn lt-btn--outline lt-btn--wide" href="/contact">Contact Team</a><div class="lt-urgent-card"><h3>Need urgent help?</h3><p>Open a service request and include the order, serial number and production impact.</p><a class="lt-btn lt-btn--blue lt-btn--wide" href="/service">Open Priority Ticket</a></div></aside></div>
        </div></section></t>
    </template>

    <template id="company_profile" name="Company Profile">
        <t t-call="portal.portal_layout"><nav class="lt-portal-breadcrumb"><a href="/my">Overview</a><span>/</span>Company Profile</nav><header class="lt-portal-heading"><h1>Company Profile</h1><p>Your company's registered information and partner approval status.</p></header>
            <div t-if="request.params.get('change_submitted')" class="lt-alert lt-alert--success">Change request <strong t-out="request.params.get('change_submitted')"/> was submitted for review.</div>
            <section t-att-class="'lt-company-status ' + ('is-approved' if company.b2b_approved else 'is-pending')"><span><i t-att-class="'fa ' + ('fa-check-circle' if company.b2b_approved else 'fa-clock-o')"/></span><div><strong t-out="'Partner Hub Approved' if company.b2b_approved else 'Partner Approval Pending'"/><p t-out="'Your company has access to approved partner pricing and services.' if company.b2b_approved else 'Lucky Tone staff are reviewing your company account.'"/></div></section>
            <div class="lt-company-layout"><section class="lt-portal-card lt-company-card"><header><h2>Company Information</h2><span class="lt-readonly-badge"><i class="fa fa-lock"/> Read only</span></header><div class="lt-company-grid"><div><label>Company name</label><strong t-out="company.name"/></div><div><label>Tax ID</label><strong t-out="company.vat or '—'"/></div><div><label>Business Email</label><strong t-out="company.email or '—'"/></div><div><label>Telephone</label><strong t-out="company.phone or '—'"/></div><div class="lt-company-grid__wide"><label>Registered Address</label><strong t-out="company.contact_address or '—'"/></div></div></section><aside class="lt-portal-card lt-company-help"><header><h2>Need to update this?</h2></header><p>Company information is maintained by Lucky Tone to protect account access and pricing permissions.</p><a class="lt-btn lt-btn--outline lt-btn--wide" href="/my/company/change">Request a Company Change</a><a href="/my/account">Edit my personal profile →</a></aside></div>
            <section t-if="change_requests" class="lt-portal-card lt-company-requests"><header><h2>Recent Change Requests</h2></header><div class="lt-request-list"><article t-foreach="change_requests" t-as="change"><div><strong t-out="change.name"/><span t-att-class="'lt-status-badge lt-status-badge--%s' % change.state" t-out="dict(change._fields['state'].selection).get(change.state)"/></div><p t-out="change.subject"/><small t-field="change.create_date" t-options="{'widget': 'date'}"/></article></div></section>
        </t>
    </template>

    <template id="company_users" name="Company Users">
        <t t-call="portal.portal_layout"><nav class="lt-portal-breadcrumb"><a href="/my">Overview</a><span>/</span>Company Users</nav><header class="lt-portal-heading lt-portal-heading--action"><div><h1>Company Users</h1><p>Contacts currently associated with <t t-out="company.name"/>.</p></div><a class="lt-btn lt-btn--outline" href="/my/company/change?type=user_change">Request a User Change</a></header>
            <div class="lt-portal-card lt-table-card"><header><h2>Company Contacts</h2><span><t t-out="len(contacts)"/> contacts</span></header><div t-if="contacts" class="table-responsive"><table class="lt-data-table"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Portal Access</th></tr></thead><tbody><tr t-foreach="contacts" t-as="contact"><td><strong t-out="contact.name"/></td><td t-out="contact.email or '—'"/><td t-out="contact.phone or '—'"/><td><span t-att-class="'lt-status-badge ' + ('lt-status-badge--approved' if contact.user_ids else 'lt-status-badge--neutral')" t-out="'Active' if contact.user_ids else 'Contact only'"/></td></tr></tbody></table></div><div t-else="" class="lt-empty lt-empty--compact"><p>No additional company contacts are visible.</p></div></div><p class="lt-portal-note"><i class="fa fa-info-circle"/> User access changes are reviewed by Lucky Tone. Submit a request rather than sharing login credentials.</p>
        </t>
    </template>
</odoo>
