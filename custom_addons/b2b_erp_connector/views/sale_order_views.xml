<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_b2b_erp" model="ir.ui.view">
        <field name="name">sale.order.form.b2b.erp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_b2b_erp_jobs" type="object" class="oe_stat_button" icon="fa-exchange" invisible="b2b_erp_job_count == 0" groups="b2b_core.group_b2b_operator">
                    <field name="b2b_erp_job_count" widget="statinfo" string="ERP Jobs"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="b2b_erp_reference" readonly="1" groups="b2b_core.group_b2b_operator"/>
            </xpath>
        </field>
    </record>
</odoo>
