<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A narrow, native-model workspace lets Marketing maintain ecommerce
         media without granting write access to product templates or prices. -->
    <record id="view_product_image_b2b_media_list" model="ir.ui.view">
        <field name="name">product.image.b2b.media.list</field>
        <field name="model">product.image</field>
        <field name="arch" type="xml">
            <list default_order="product_tmpl_id, sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="product_tmpl_id" required="1"/>
                <field name="name"/>
                <field name="video_url" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_product_image_b2b_media_form" model="ir.ui.view">
        <field name="name">product.image.b2b.media.form</field>
        <field name="model">product.image</field>
        <field name="arch" type="xml">
            <form string="Product Media">
                <sheet>
                    <group>
                        <group>
                            <field name="product_tmpl_id" required="not product_variant_id" options="{'no_create': True}"/>
                            <field name="product_variant_id" domain="[('product_tmpl_id', '=', product_tmpl_id)]" options="{'no_create': True}"/>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="video_url"/>
                        </group>
                        <group><field name="image_1920" widget="image" class="oe_avatar"/></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_product_image_b2b_media_search" model="ir.ui.view">
        <field name="name">product.image.b2b.media.search</field>
        <field name="model">product.image</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="product_variant_id"/>
                <filter name="videos" string="Videos" domain="[('video_url', '!=', False)]"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_tmpl_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_b2b_product_media" model="ir.actions.act_window">
        <field name="name">Product Media</field>
        <field name="res_model">product.image</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_product_image_b2b_media_search"/>
        <field name="context">{'search_default_group_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add product images or video links</p>
            <p>Media is stored in Odoo's native product media model.</p>
        </field>
    </record>
</odoo>
