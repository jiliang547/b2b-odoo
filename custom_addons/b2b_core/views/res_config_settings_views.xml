<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_b2b" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.b2b</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="website_payment_block" position="after">
                <block title="Partner Hub" id="b2b_partner_hub_settings">
                    <setting string="Price visibility" help="Controls whether numeric B2B prices are returned to the browser.">
                        <field name="b2b_price_display_mode"/>
                    </setting>
                    <setting string="Guest price state">
                        <field name="b2b_guest_price_state"/>
                    </setting>
                    <setting string="Authenticated no-price state">
                        <field name="b2b_no_price_state"/>
                    </setting>
                    <setting string="Require approved customer at checkout">
                        <field name="b2b_require_approved_checkout"/>
                    </setting>
                    <setting name="b2b_require_approved_sample_setting" string="Require approved customer for samples">
                        <field name="b2b_require_approved_sample"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
