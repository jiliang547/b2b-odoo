<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <function model="website" name="write">
        <value eval="[ref('website.default_website')]"/>
        <value eval="{'homepage_url': '/partner-home'}"/>
    </function>

    <template id="homepage_featured_card" name="Homepage Featured Product Card">
        <article class="pg-featured-card">
            <a class="pg-featured-card__image" t-att-href="'/products/%s' % request.env['ir.http']._slug(product)">
                <span t-if="section == 'special' and price.get('base_price') and price.get('base_price') &gt; price.get('price', 0)" class="pg-sale-badge">SALE</span>
                <img t-att-src="'/web/image/product.template/%s/image_512' % product.id" t-att-alt="product.name" loading="lazy"/>
            </a>
            <div class="pg-featured-card__body">
                <h3><a t-att-href="'/products/%s' % request.env['ir.http']._slug(product)" t-out="product.name"/></h3>
                <p class="pg-featured-card__sku" t-out="product.b2b_model_number or product.product_variant_id.default_code or 'On request'"/>
                <p class="pg-featured-card__summary" t-out="product.description_sale or 'Professional audio solution for partner projects.'"/>
                <div class="pg-featured-card__purchase">
                    <div class="pg-featured-card__pricing">
                        <div t-if="price.get('state') == 'visible'" class="pg-featured-card__price">
                            <strong t-out="price.get('price')" t-options="{'widget': 'monetary', 'display_currency': price.get('currency')}"/>
                            <del t-if="section == 'special' and price.get('base_price') and price.get('base_price') &gt; price.get('price', 0)" t-out="price.get('base_price')" t-options="{'widget': 'monetary', 'display_currency': price.get('currency')}"/>
                        </div>
                        <a t-elif="price.get('state') == 'login'" class="pg-featured-card__price-link" t-att-href="'/web/login?redirect=%s' % request.httprequest.path">Sign in to view price</a>
                        <a t-else="" class="pg-featured-card__price-link" href="/contact">Contact sales for pricing</a>
                        <span class="pg-featured-card__moq">MOQ: <t t-out="procurement.get('minimum_quantity', 1)"/> <t t-out="procurement.get('uom_name') or 'pcs'"/></span>
                    </div>
                    <a class="lt-btn lt-btn--small pg-featured-card__view" t-att-href="'/products/%s' % request.env['ir.http']._slug(product)">View</a>
                </div>
            </div>
        </article>
    </template>

    <template id="partner_hub_homepage_power_grace" inherit_id="b2b_website.partner_hub_homepage" name="Power and Grace Homepage">
        <xpath expr="//t[@t-call='b2b_website.partner_layout']" position="replace">
            <t t-call="b2b_website.partner_layout">
                <section class="pg-hero">
                    <img class="pg-hero__image" src="/b2b_website/static/src/img/power_grace_hero.jpg" alt="Professional audio equipment"/>
                    <div class="pg-hero__shade"/>
                    <div class="container pg-hero__content"><div class="pg-hero__grid"><div class="pg-hero__copy"><span class="pg-hero__eyebrow">B2B Partner Portal</span><h1>Professional Audio<br/><em>Solution B2B Supply</em></h1><p>POWER &amp; GRACE Partner Hub — We are your strategic partner for cost-effective, One-stop audio excellence.</p><div class="lt-actions"><a class="lt-btn lt-btn--lime" href="/products"><i class="fa fa-bars"/> Explore Products</a><a class="lt-btn lt-btn--hero-outline" href="/contact">Contact Sales</a></div></div><div class="pg-hero__services"><a href="/products"><i class="fa fa-tags"/><strong>Partner Pricing</strong><small>Account-specific B2B pricing</small></a><a t-att-href="'/samples' if not request.env.user._is_public() else '/web/login?redirect=/samples'"><i class="fa fa-flask"/><strong>Sample Evaluation</strong><small>Request products for project testing</small></a><a href="/repair-service"><i class="fa fa-wrench"/><strong>Project Support</strong><small>Order-linked after-sales support</small></a><a href="/warranty"><i class="fa fa-shield"/><strong>Up to 5-Year Warranty</strong><small>Product-specific warranty coverage</small></a></div></div></div>
                </section>

                <section class="pg-home-section"><div class="container"><div class="pg-section-heading"><div><h2>Product Categories</h2><p>Browse by product type</p></div></div>
                    <div class="pg-category-browser" data-pg-category-browser="" data-brand-id="">
                        <div class="pg-category-browser__trail" data-pg-category-trail="" hidden="hidden"><button type="button" data-pg-category-back=""><i class="fa fa-arrow-left"/> Back</button><span>|</span><nav aria-label="Category breadcrumb" data-pg-category-breadcrumbs=""/></div>
                        <div t-if="root_categories" class="pg-category-grid" data-pg-category-grid=""><button t-foreach="root_categories" t-as="row" type="button" t-att-data-category-id="row['id']" t-att-data-has-children="'1' if row['has_children'] else '0'"><span><img t-att-src="row['image_url']" t-att-alt="row['name']" loading="lazy"/></span><strong t-out="row['name']"/></button></div>
                        <div t-else="" class="lt-empty" data-pg-category-empty=""><p>Published product categories will appear here.</p></div>
                    </div>
                </div></section>

                <section class="pg-home-section pg-home-section--soft"><div class="container"><div class="pg-section-heading"><div><h2>Featured Products</h2><p>Curated selections updated by our team</p></div></div>
                    <div class="pg-featured" data-pg-featured="">
                        <div class="pg-featured__tabs" role="tablist"><button type="button" class="is-active" role="tab" aria-selected="true" data-pg-featured-tab="recommended">Recommended</button><button type="button" role="tab" aria-selected="false" data-pg-featured-tab="special">Special Offers</button><button type="button" role="tab" aria-selected="false" data-pg-featured-tab="best_seller">Best Sellers</button></div>
                        <t t-foreach="[('recommended', recommended_products), ('special', special_products), ('best_seller', best_seller_products)]" t-as="featured_section">
                            <div t-att-class="'pg-featured__panel is-active' if featured_section[0] == 'recommended' else 'pg-featured__panel'" t-att-data-pg-featured-panel="featured_section[0]" t-att-hidden="None if featured_section[0] == 'recommended' else 'hidden'">
                                <button t-if="featured_section[1]" type="button" class="pg-carousel-arrow pg-carousel-arrow--left" data-pg-scroll="left" aria-label="Scroll left"><i class="fa fa-angle-left"/></button>
                                <div t-if="featured_section[1]" class="pg-featured__viewport"><div class="pg-featured__track" data-pg-featured-track=""><t t-foreach="featured_section[1]" t-as="product"><t t-set="section" t-value="featured_section[0]"/><t t-set="price" t-value="featured_prices.get(product.id, {})"/><t t-set="procurement" t-value="featured_procurement.get(product.id, {})"/><t t-call="b2b_website.homepage_featured_card"/></t></div></div>
                                <div t-else="" class="lt-empty"><p>This selection is being prepared by our product team.</p></div>
                                <button t-if="featured_section[1]" type="button" class="pg-carousel-arrow pg-carousel-arrow--right" data-pg-scroll="right" aria-label="Scroll right"><i class="fa fa-angle-right"/></button>
                            </div>
                        </t>
                    </div>
                </div></section>

                <section id="our-brands" class="pg-home-section"><div class="container"><div class="pg-section-heading"><div><h2>Our Brands</h2><p>Professional audio brands exclusively distributed through the Partner Hub</p></div></div><div t-if="homepage_brands" class="pg-brand-grid"><a t-foreach="homepage_brands[:6]" t-as="brand" t-att-href="'/brands/%s' % request.env['ir.http']._slug(brand)"><span class="pg-brand-grid__visual"><img t-if="brand.cover_image" t-att-src="'/web/image/b2b.product.brand/%s/cover_image' % brand.id" t-att-alt="brand.name"/><span t-else="" t-out="brand.name"/></span><small t-out="brand.tagline or 'Professional Audio Solutions'"/><b>View brand <i class="fa fa-angle-right"/></b></a></div><div t-else="" class="lt-empty"><p>Published partner brands will appear here.</p></div></div></section>
                <section class="pg-partner-cta"><div class="container"><div class="pg-partner-cta__copy"><h2>Ready to become a partner?</h2><p>Apply for a B2B partner account to access exclusive pricing, sample requests, technical documentation, and dedicated account support.</p></div><div class="lt-actions"><a class="lt-btn lt-btn--lime" href="/partner-application">Apply for Partnership</a><a class="lt-btn pg-partner-cta__secondary" href="/contact">Contact Sales Team</a></div></div></section>
            </t>
        </xpath>
    </template>

    <template id="brand_detail" name="Partner Brand Detail">
        <t t-call="b2b_website.partner_layout"><section class="pg-brand-hero"><div class="container"><nav class="pg-breadcrumb"><a href="/">Home</a><span>/</span><a href="/#our-brands">Our Brands</a><span>/</span><b t-out="brand.name"/></nav><div class="pg-brand-hero__content"><img t-if="brand.logo" t-att-src="'/web/image/b2b.product.brand/%s/logo' % brand.id" t-att-alt="brand.name"/><div t-else="" class="pg-brand-hero__wordmark" t-out="brand.name"/><div><h1 t-out="brand.name"/><p t-out="brand.tagline or 'Professional Audio Solutions'"/></div></div></div></section>
            <section class="pg-home-section"><div class="container"><div class="pg-section-heading"><div><h2>Product Categories</h2><p>Browse <t t-out="brand.name"/> products by category</p></div></div><div class="pg-category-browser" data-pg-category-browser="" t-att-data-brand-id="brand.id"><div class="pg-category-browser__trail" data-pg-category-trail="" hidden="hidden"><button type="button" data-pg-category-back=""><i class="fa fa-arrow-left"/> Back</button><span>|</span><nav aria-label="Category breadcrumb" data-pg-category-breadcrumbs=""/></div><div class="pg-category-grid" data-pg-category-grid=""><button t-foreach="brand_categories" t-as="row" type="button" t-att-data-category-id="row['id']" t-att-data-has-children="'1' if row['has_children'] else '0'"><span><img t-att-src="row['image_url']" t-att-alt="row['name']"/></span><strong t-out="row['name']"/></button></div></div></div></section>
            <section class="pg-home-section pg-home-section--soft"><div class="container"><div class="pg-section-heading pg-section-heading--action"><div><h2>Featured Products</h2></div><a t-att-href="'/products?brand=%s' % brand.id">View all <i class="fa fa-arrow-right"/></a></div><div class="pg-featured__track pg-featured__track--brand"><t t-foreach="brand_products" t-as="product"><t t-set="section" t-value="'brand'"/><t t-set="price" t-value="brand_prices.get(product.id, {})"/><t t-set="procurement" t-value="request.env['b2b.product.service'].procurement_info(product.product_variant_id, pricelist=request.pricelist, website=website)"/><t t-call="b2b_website.homepage_featured_card"/></t></div></div></section>
            <section class="pg-brand-about"><div class="container"><div><h2>About <t t-out="brand.name"/></h2><div t-if="brand.website_description" class="lt-richtext" t-field="brand.website_description"/><p t-else="" t-out="brand.description or 'Contact our sales team to learn more about this brand and its professional product range.'"/></div><aside><div t-if="brand_focus"><h3>Product Focus</h3><div class="pg-chip-list"><span t-foreach="brand_focus" t-as="item" t-out="item"/></div></div><div t-if="brand_advantages"><h3>Brand Advantages</h3><ul><li t-foreach="brand_advantages" t-as="item"><i class="fa fa-check"/><t t-out="item"/></li></ul></div></aside></div></section>
            <section class="pg-partner-cta"><div class="container"><div><h2 t-out="brand.name"/><p t-out="brand.tagline or 'Professional Audio Solutions'"/></div><div class="lt-actions"><a class="lt-btn lt-btn--lime" t-att-href="'/products?brand=%s' % brand.id">Browse Brand Products</a><a class="lt-btn lt-btn--light" href="/contact">Contact Sales</a></div></div></section></t>
    </template>

    <template id="repair_service_page" name="Project Support Introduction"><t t-call="b2b_website.partner_layout"><section class="pg-policy-hero"><div class="container"><span>After-Sales Support</span><h1>Project Support</h1><p>Order-linked repair and maintenance support for POWER &amp; GRACE and partner brand products. Submit a request, track progress, and get your equipment back in service.</p><a class="lt-btn lt-btn--lime" t-att-href="'/service' if not request.env.user._is_public() else '/web/login?redirect=/service'">Submit a Repair Request</a></div></section><section class="pg-policy-section"><div class="container"><h2>Supported Service Types</h2><p>We service a wide range of hardware faults across all supported product categories.</p><div class="pg-service-grid"><article><i class="fa fa-plug"/><h3>Electrical Faults</h3><p>Power circuits, fuses, short circuits, and component-level failures.</p></article><article><i class="fa fa-volume-up"/><h3>Audio Quality Issues</h3><p>Distortion, noise, hum, signal loss, or degraded output.</p></article><article><i class="fa fa-wrench"/><h3>Mechanical Damage</h3><p>Housings, connectors, faders, and mechanical components.</p></article><article><i class="fa fa-wifi"/><h3>Wireless &amp; Connectivity</h3><p>Wireless dropouts, pairing, receiver, and transmitter issues.</p></article><article><i class="fa fa-microchip"/><h3>Firmware Issues</h3><p>Firmware corruption, updates, and configuration resets.</p></article><article><i class="fa fa-battery-half"/><h3>Battery &amp; Charging</h3><p>Battery life, charging ports, and battery replacement.</p></article></div></div></section><section class="pg-policy-section pg-policy-section--soft"><div class="container"><h2>How It Works</h2><div class="pg-steps"><article><b>01</b><h3>Select Order</h3><p>Identify the order containing the product.</p></article><article><b>02</b><h3>Select Product</h3><p>Specify the exact product and quantity.</p></article><article><b>03</b><h3>Describe the Issue</h3><p>Add fault details, serial number, photos, or video.</p></article><article><b>04</b><h3>Submit Request</h3><p>Receive a service reference for tracking.</p></article><article><b>05</b><h3>Track Status</h3><p>Monitor progress in My Account → Service Tickets.</p></article></div></div></section><section class="pg-policy-cta"><div class="container"><h2>Ready to submit a repair request?</h2><p>Sign in to link your request to an existing order.</p><a class="lt-btn lt-btn--lime" t-att-href="'/service' if not request.env.user._is_public() else '/web/login?redirect=/service'">Submit Repair Request</a></div></section></t></template>

    <template id="warranty_page" name="Warranty Policy"><t t-call="b2b_website.partner_layout"><section class="pg-policy-hero"><div class="container"><span>Partner Protection</span><h1>Warranty Policy</h1><p>POWER &amp; GRACE offers product-specific warranty coverage. Certain premium models qualify for up to 5-year warranty—check the individual product documentation for the applicable period.</p><div class="pg-policy-notice"><i class="fa fa-info-circle"/> Warranty coverage is not uniform across all products. The product datasheet and order confirmation take precedence.</div></div></section><section class="pg-policy-section"><div class="container"><h2>Product-Specific Warranty Periods</h2><div class="table-responsive"><table class="pg-warranty-table"><thead><tr><th>Product Category</th><th>Typical Warranty Period</th></tr></thead><tbody><tr><td>Wired Microphones</td><td>2 Years</td></tr><tr><td>Wireless Microphone Systems</td><td>2 Years</td></tr><tr><td>Portable Speakers &amp; PA Systems</td><td>1 Year</td></tr><tr><td>Power Amplifiers</td><td>2 Years</td></tr><tr><td>Mixing Consoles</td><td>1 Year</td></tr><tr><td>Studio Headphones</td><td>2 Years</td></tr><tr><td>Select Premium Models</td><td><strong>Up to 5 Years*</strong></td></tr></tbody></table></div><p class="pg-policy-footnote">* Up to 5-Year Warranty applies only to select premium models. Confirm in the product documentation.</p></div></section><section class="pg-policy-section pg-policy-section--soft"><div class="container pg-coverage"><div><h2>Coverage</h2><ul><li><i class="fa fa-check"/> Manufacturing defects</li><li><i class="fa fa-check"/> Component failure under normal use</li><li><i class="fa fa-check"/> Production-related electrical faults</li></ul></div><div><h2>Exclusions</h2><ul><li><i class="fa fa-times"/> User-caused physical damage</li><li><i class="fa fa-times"/> Unauthorized modifications</li><li><i class="fa fa-times"/> Normal wear and tear</li><li><i class="fa fa-times"/> Incorrect power supply or voltage</li><li><i class="fa fa-times"/> Liquid damage unless the model is rated for it</li></ul></div></div></section><section class="pg-policy-section"><div class="container"><h2>How to Make a Claim</h2><div class="pg-steps"><article><b>01</b><h3>Locate Purchase</h3><p>Find the order or invoice in your account.</p></article><article><b>02</b><h3>Identify Product</h3><p>Prepare the SKU and serial number.</p></article><article><b>03</b><h3>Submit Request</h3><p>Select Repair and describe the warranty issue.</p></article><article><b>04</b><h3>Assessment</h3><p>Our team confirms eligibility and next steps.</p></article><article><b>05</b><h3>Resolution</h3><p>Approved claims proceed to repair or replacement.</p></article></div></div></section><section class="pg-policy-cta"><div class="container"><h2>Need to submit a warranty claim?</h2><p>Sign in to submit a service request linked to your order.</p><div class="lt-actions"><a class="lt-btn lt-btn--lime" t-att-href="'/service' if not request.env.user._is_public() else '/web/login?redirect=/service'">Submit Service Request</a><a class="lt-btn lt-btn--outline" href="/contact">Contact Support</a></div></div></section></t></template>
</odoo>
