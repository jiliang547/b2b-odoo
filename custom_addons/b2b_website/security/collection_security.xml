<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_b2b_finance" model="res.groups"><field name="name">B2B Finance</field><field name="implied_ids" eval="[Command.link(ref('b2b_core.group_b2b_operator')), Command.link(ref('account.group_account_invoice'))]"/></record>
    <record id="access_collection_brand_finance" model="ir.model.access"><field name="name">Brand receiving accounts finance</field><field name="model_id" ref="b2b_core.model_b2b_product_brand"/><field name="group_id" ref="b2b_website.group_b2b_finance"/><field name="perm_read" eval="True"/><field name="perm_write" eval="True"/></record>
    <record id="access_collection_policy_operator" model="ir.model.access"><field name="name">Collection policy read</field><field name="model_id" ref="model_b2b_collection_policy"/><field name="group_id" ref="b2b_core.group_b2b_operator"/><field name="perm_read" eval="True"/></record>
    <record id="access_collection_policy_manager" model="ir.model.access"><field name="name">Collection policy manager</field><field name="model_id" ref="model_b2b_collection_policy"/><field name="group_id" ref="b2b_core.group_b2b_manager"/><field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/></record>
    <record id="access_bank_receipt_operator" model="ir.model.access"><field name="name">Receipt operations read</field><field name="model_id" ref="model_b2b_bank_receipt"/><field name="group_id" ref="b2b_core.group_b2b_operator"/><field name="perm_read" eval="True"/></record>
    <record id="access_bank_receipt_finance" model="ir.model.access"><field name="name">Receipt finance</field><field name="model_id" ref="model_b2b_bank_receipt"/><field name="group_id" ref="group_b2b_finance"/><field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/></record>
    <record id="rule_receipt_company" model="ir.rule"><field name="name">Receipt selling company isolation</field><field name="model_id" ref="model_b2b_bank_receipt"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="access_pi_staff" model="ir.model.access"><field name="name">Issued PI staff read</field><field name="model_id" ref="model_b2b_order_pi"/><field name="group_id" ref="b2b_core.group_b2b_operator"/><field name="perm_read" eval="True"/></record>
    <record id="rule_pi_company" model="ir.rule"><field name="name">PI selling company isolation</field><field name="model_id" ref="model_b2b_order_pi"/><field name="domain_force">[('order_id.company_id', 'in', company_ids)]</field></record>
</odoo>
