<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_partner_hub" inherit_id="portal.portal_my_home" name="Partner Hub Portal Cards">
        <xpath expr="//div[@id='portal_service_category']" position="before"><t t-set="portal_service_category_enable" t-value="True"/></xpath>
        <xpath expr="//div[@id='portal_service_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Sample Requests</t><t t-set="text">Review sample application status and ERP handoff</t><t t-set="url" t-value="'/samples'"/><t t-set="placeholder_count" t-value="'sample_count'"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">After-sales Service</t><t t-set="text">Create repair or replacement requests</t><t t-set="url" t-value="'/service-center'"/><t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o_portal_my_home')]" position="inside">
            <div t-if="request.params.get('service_submitted')" class="alert alert-success mt-3" role="status">Your service request was submitted successfully. Track it in Helpdesk.</div>
        </xpath>
    </template>

    <template id="portal_my_sample_requests" name="My Sample Requests">
        <t t-call="portal.portal_layout"><t t-set="no_index" t-value="True"/>
            <t t-set="breadcrumbs_searchbar" t-value="True"/><t t-call="portal.portal_searchbar"><t t-set="title">Sample Requests</t></t>
            <div class="lt-list-intro"><span class="lt-kicker">SAMPLES</span><h1>Sample requests</h1><p>Review approval, fulfilment and ERP handoff state.</p></div>
            <div class="d-flex justify-content-end mb-3"><a class="btn btn-primary" href="/products">Request a sample</a></div>
            <div t-if="not samples" class="alert alert-info">You have not submitted any sample requests yet.</div>
            <t t-else=""><t t-call="portal.portal_table"><thead><tr><th>Request</th><th>Submitted</th><th>Products</th><th>Status</th><th>ERP</th></tr></thead><tbody><tr t-foreach="samples" t-as="sample"><td><a t-att-href="'/my/sample-requests/%s' % sample.id" t-out="sample.name"/></td><td><span t-field="sample.create_date" t-options="{'widget': 'datetime'}"/></td><td t-out="', '.join(sample.line_ids.product_id.mapped('display_name'))"/><td><span t-att-class="'lt-status-badge lt-status-badge--%s' % sample.state" t-out="dict(sample._fields['state'].selection).get(sample.state)"/></td><td t-out="sample.erp_reference or 'Pending'"/></tr></tbody></t></t>
        </t>
    </template>

    <template id="portal_sample_request" name="Sample Request Detail">
        <t t-call="portal.portal_layout"><t t-set="no_index" t-value="True"/>
            <div class="lt-sample-detail py-4">
                <div t-if="submitted" class="alert alert-success" role="status">Your sample request was submitted successfully.</div>
                <div class="d-flex align-items-start justify-content-between gap-3 mb-4"><div><a href="/my/sample-requests">← Sample requests</a><h1 class="mt-2" t-out="sample.name"/><p class="text-muted" t-field="sample.create_date"/></div><span t-att-class="'lt-status-badge lt-status-badge--%s' % sample.state" t-out="dict(sample._fields['state'].selection).get(sample.state)"/></div>
                <div class="row g-4"><div class="col-lg-8"><div class="card"><div class="card-body"><h2 class="h4">Requested products</h2><table class="table"><thead><tr><th>Product</th><th>Quantity</th></tr></thead><tbody><tr t-foreach="sample.line_ids" t-as="line"><td t-out="line.product_id.display_name"/><td><t t-out="line.quantity"/> <t t-out="line.uom_id.name"/></td></tr></tbody></table><h2 class="h4 mt-4">Reason</h2><p class="text-break" t-out="sample.reason"/><h2 t-if="sample.notes" class="h4 mt-4">Notes</h2><p t-if="sample.notes" class="text-break" t-out="sample.notes"/></div></div></div><aside class="col-lg-4"><div class="card"><div class="card-body"><h2 class="h4">Delivery contact</h2><dl><dt>Name</dt><dd t-out="sample.contact_name"/><dt>Company</dt><dd t-out="sample.company_name"/><dt>Email</dt><dd t-out="sample.email"/><dt>Phone</dt><dd t-out="sample.phone"/><dt>Shipping address</dt><dd class="text-break" t-out="sample.shipping_address"/></dl><div t-if="sample.erp_reference" class="alert alert-success mb-0"><strong>ERP reference</strong><br/><span t-out="sample.erp_reference"/></div><div t-elif="sample.state == 'erp_failed'" class="alert alert-warning mb-0">ERP synchronization requires staff attention.</div></div></div></aside></div>
            </div>
        </t>
    </template>
</odoo>
